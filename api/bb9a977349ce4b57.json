ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"6b340c58c71a4d0cdbad272d","items":[{"id":"bc77c9c2bb314e1cbef5a6c7","open":false,"title":"K čemu je operativní leasing vlastně dobrý?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Operativní leasing je dlouhodobý pronájem vozu. Je to vlastně takové zapůjčení vozidla na dobu určitou, po jejímž skončení vůz vrátíte a můžete si zapůjčit nový model. Výhodou operativního leasingu je znatelně nižší měsíční platba, než je tomu u splátek klasického leasingu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"4293f513d285ddbcae35221d","open":false,"title":"Jaký je rozdíl mezi finančním a operativním leasingem?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V případě finančního leasingu přechází věc do vlastnictví klienta, kdežto u operativního leasingu se věc vrací zpět leasingové společnosti. Operativní leasing je vhodným řešením pro klienty, kteří danou věc potřebují pouze na určitou dobu anebo po skončení potřebné doby plánují její výměnu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"44efd6f797658771652b79c2","open":false,"title":"Má auto na leasing nějaké podmínky, omezení?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Operativní leasing nemá prakticky žádná omezení jen výhody. Musíme však myslet na to že vozidlo je v tomto případě věc pronajatá tedy vypůjčená a musíme ho vrátit v co nejlepším stavu. Je tedy nutné před vrácením vozidla navštívit servis a nechat zkontrolovat jestli za dobu používání nedošlo k poškození vozidla a toto případně nechat opravit z havarijního pojištění. V této věci Vám bude plně k dispozici oddělení likvidace pojistných událostí Allrisk.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"label":"Časté dotazy","title":"Odpovědi na vaše nejčastější otázky","anchor":null,"numbered":true,"blockName":"","blockType":"accordions"},"format":"","version":2},{"type":"block","fields":{"id":"2bc5a9d2be37cfce4383b071","lead":null,"label":"Podobné produkty","title":"Tím to *nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"f12f4deb5381f506943a0bc2","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":5,"_order":"a4","adminTitle":"Allrisk EFFECTIVE","title":"Allrisk EFFECTIVE","heroTitle":null,"description":"Program vlastních produktů Allrisk, který vám šetří peníze. Telefonujte s námi, využijte autopůjčovnu nebo k nám převeďte správu energií a získejte roční bonusy.","heroPhoto":{"id":154,"alt":"Allrisk EFFECTIVE","visibility":"public","folder":1387,"updatedAt":"2026-11-02T14:21:15.080Z","createdAt":"2026-11-02T14:21:15.080Z","url":"/allrisk-web-prototyp/media/portfolio-allrisk-effective-hero.jpg","thumbnailURL":null,"filename":"portfolio-allrisk-effective-hero.jpg","mimeType":"image/jpeg","filesize":504349,"width":2560,"height":1804,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Klubový projekt na snížení provozních nákladů.","icon":"IconSparkles","isActive":true,"parent":n