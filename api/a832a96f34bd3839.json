rem blesku","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"dalšími živelnými pohromami: vichřice, krupobití, zemětřesení, tíha sněhu, apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"krádeží nebo vandalem: tedy odcizení, poškození nebo zničení stavebních součástí","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"vodou vytékající z vodovodního zařízení: např. prasklé potrubí","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"přepětím, podpětím: či zkratem v elektrické síti, které způsobí poškození el. zařízení stavby - elektromotory a řídící jednotky","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":7,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojistíme vám: v rámci stavby i skla a sanitu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":8,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"a mnoho dalších rizik, které ohrožují vaši nemovitost","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"bf4097b8d2e0e7b95c19fc77","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"f