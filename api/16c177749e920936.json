g","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jak vám pomůžeme","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"S naším produktem pojištění kybernetických rizik můžete chránit svou firmu před kybernetickými hrozbami a finančními ztrátami spojenými s únikem dat, kybernetickými útoky nebo jinými online riziky. Zabezpečte své podnikání s naším komplexním pojištěním, které vám poskytne klid a jistotu v digitálním prostředí. Tento typ pojištění je vhodný pro OSVČ a firmy.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění kybernetických rizik představuje důležitý nástroj pro ochranu vaší společnosti v digitálním světě. Ale co vše lze v rámci tohoto pojištění skutečně chránit?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"60539e7126eb0cbc8039094f","label":null,"photo":{"id":229,"alt":"Pokryjeme náklady a finanční ztráty, které vzniknou v důsledku kybernetického incidentu. To zahrnuje:","visibility":"public","folder":1413,"updatedAt":"2026-11-02T14:21:19.177Z","createdAt":"2026-11-02T14:21:19.177Z","url":"/allrisk-web-prototyp/media/kyberneticka-rizika-photo.jpg","thumbnailURL":null,"filename":"kyberneticka-rizika-photo.jpg","mimeType":"image/jpeg","filesize":675502,"width":1250,"height":833,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokryjeme náklady a finanční ztráty, které vzniknou v důsledku kybernetického incidentu. To zahrnuje:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Náklady na odborníky, včetně IT specialistů pro prošetření incidentu a právní zástupce pro právní obhajobu.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Finanční ztrátu spojenou s přerušením nebo omezením provozu a dalšími souvisejícími náklady.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obnova dat","type":"text","style":"","detail":0,"format":1,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Pojištění kryje náklady na obnovu dat a software po kybernetickém incidentu (například hacking nebo omylem vymazaná data) za podmínky, že existují použitelné zálohy.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Náklady na aktualizaci či vylepšení dat nebo software, stejně jako samotná hodnota dat kryté v pojištění nejsou.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za újmu vyplývající z porušení ochrany dat","type":"text","style":"","detail":0,"format":1,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Pojištění se vztahuje i na odpovědnost pojištěného za újmu/škodu způsobenou třetí straně porušením ochrany dat, způsobeným kybernetickým incidentem.","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Kryté jsou tedy náhodné nebo nezákonné zničení, ztráta, změna, neoprávněné zveřejnění nebo přístup k důvěrným informacím nebo osobním údajům přenášeným, uloženým nebo zpracovávaným na vašich počítačových systémech.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za bezpečnost sítí","type":"text","style":"","detail":0,"format":1,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Pojištění se vztahuje i na odpovědnost pojištěného za újmu/škodu způsobenou třetí straně kybernetickým incidentem v počítačovém systému pojištěného, kterému pojištěný nedokázal zabránit a způsobil poškození, změnu, zničení nebo krádež dat nebo útok Denial of Service (DoS) na počítačovém systému třetí strany.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"6594828d4393e43615228de9","lead":null,"label":"Podobné produkty","title":"Pojištěním kybernetických rizik *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"2c0aaf0c8ec07aad76a29be9","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání před dopady nečekaných událostí. Spolupracujeme s většinou pojišťoven na trhu, a tak vám i vaší rodině najdeme to nejvýhodnější krytí.","heroPhoto":{"id":150,"alt":"Pojištění","visibility":"public","folder":1383,"updatedAt":"2026-11-02T14:21:14.790Z","createdAt":