:0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přidejte se do týmu lidí, kteří jsou podporou pro naše klienty a kolegy z obchodní sítě. Ekonomika, HR, IT, likvidace, marketing, finance a obchod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kariéra v obchodě","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Podnikejte s Allriskem. K dispozici jsou vám nejen naše nástroje a produkty, ale i propracovaný systém vzdělávacích programů v oblasti obchodního, odborného i manažerského růstu.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"block","fields":{"id":"f91522f71ba3574b14425b42","actions":[{"id":"6af45e8dfed2c9f4e6f8dfd7","doc":{"value":{"id":3,"adminTitle":"Na centrále","title":"Na centrále","heroTitle":"Plňte si své sny s námi. Kariéra v Allrisku.","description":"Kanceláře centrály zajišťují správný chod celé společnosti. Počítáme jak s profesionály ve svém oboru, tak máme volné pozice i pro studenty a absolventy.","heroPhoto":{"id":368,"alt":"Na centrále","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:33.091Z","createdAt":"2026-11-02T14:21:33.091Z","url":"/allrisk-web-prototyp/media/allrisk-kariera-backoffice.jpg","thumbnailURL":null,"filename":"allrisk-kariera-backoffice.jpg","mimeType":"image/jpeg","filesize":616834,"width":800,"height":426,"focalX":50,"focalY":50},"isActive":true,"segment":"general","slug":"kariera-na-centrale","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:45.544Z","createdAt":"2026-11-02T14:21:48.045Z","_status":"published"},"relationTo":"allrisk-pa