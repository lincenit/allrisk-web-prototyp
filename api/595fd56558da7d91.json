","title":"Bankovní produkty","heroTitle":"Bankovní *produkty*","description":"Běžné účty, termínované vklady i vklady s výpovědní lhůtou. Peníze máte rychle k dispozici a chráněné pojištěním vkladů.","heroPhoto":{"id":182,"alt":"Bankovní produkty","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.203Z","createdAt":"2026-11-02T14:21:16.203Z","url":"/allrisk-web-prototyp/media/bankovni-produkty-hero.jpg","thumbnailURL":null,"filename":"bankovni-produkty-hero.jpg","mimeType":"image/jpeg","filesize":750581,"width":1500,"height":1000,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Firemní účty a platby","icon":"IconBuildingBank","isActive":true,"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","heroTitle":null,"description":"Úvěry, investice i zajištění na penzi. Náš tým specialistů vyhodnotí vaši situaci a navrhne nejlepší řešení, ať si plníte sen o vlastním bydlení, nebo myslíte na budoucnost.","heroPhoto":152,"menuTitle":null,"summary":"Úvěry, investice a účty srovnané napříč trhem.","icon":"IconCoins","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"finance","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.986Z","createdAt":"2026-11-02T14:21:25.213Z","_status":"published"},"segments":["podnikatele"],"slug":"bankovni-produkty","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:40.848Z","createdAt":"2026-11-02T14:21:25.634Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"f9913d0cc52958fbdeae4a1b","label":null,"photo":{"id":186,"alt":"Investice","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.425Z","createdAt":"2026-11-02T14:21:16.425Z","url":"/allrisk-web-prototyp/media/investice-hero.jpg","thumbnailURL":null,"filename":"investice-hero.jpg","mimeType":"image/jpeg","filesize":973834,"width":1250,"height":790,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jak vám pomůžeme","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"S odborným poradenstvím a strategickým plánem investic mohou podnikatelé maximalizovat svůj výnos a minimalizovat rizika spojená s podnikatelskými aktivitami. Investování tak představuje klíčový nástroj pro ty společnosti, které chtějí posílit svou pozici na trhu a dosáhnout dlouhodobého úspěchu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V této oblasti existuje na trhu mnoho produktů a jejich variant. Naším dlouhodobým cílem v poradenské činnosti pro naše klienty je opatrně a pečlivě vybírat jen ty, které přinášejí minimální riziko. Samozřejmostí v této činnosti je investiční dotazník, který vždy při výběru či revizi produktů s našimi klienty vyplňujeme.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Důležitost času","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Čím dříve začnete investovat, tím větší máte šanci dosáhnout cílů. Při investování je právě čas jedním z nejdůležitějších faktorů.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"12e8f23beb6b2a859fae7d8a","label":null,"photo":{"id":187,"alt":"Tato oblast je certifikovaná Českou národní bankou a naši poradci, se kterými se setkáte v rámci procesu výběru okruhu produktů, tuto certifikaci mají splněnou.","visibility":"public","folder":1397,"updatedAt":"2026-11-02T14:21:16.501Z","createdAt":"2026-11-02T14:21:16.501Z","url":"/allrisk-web-prototyp/media/investice-photo.jpg","thumbnailURL":null,"filename":"investice-photo.jpg","mimeType":"image/jpeg","filesize":630451,"width":1250,"height":752,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato oblast je certifikovaná Českou národní bankou a naši poradci, se kterými se setkáte v rámci procesu výběru okruhu produktů, tuto certifikaci mají splněnou.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Níže několik pojmů, se kterými se potkáte v rámci procesu tvorby investičního spektra.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Dlouhodobé cíle: investice jsou způsobem, jak dosáhnout dlouhodobých cílů pro vaši firmu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Zhodnocení peněz: když investujete, své peníze dáváte do produktů nebo aktiv, které mají potenciál růst a přinášet vám zisk. To je opak klasického spoření, kde jsou peníze uloženy bez výrazného zhodnocení.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Riziko a odměna: investice obvykle nesou určité riziko, ale také potenciál pro větší výnosy. Je důležité najít vyvážený přístup mezi rizikem a odměnou, aby bylo nejlepšího zhodnocení.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Různorodost investic: rozložení investic na různé aktivity (například akcie, dluhopisy, nemovitosti) může pomoci minimalizovat riziko a zabezpečit proti neočekávaným událostem na trhu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pasivní příjmy: investice mohou vytvářet pasivní příjmy, což jsou peníze, které si můžete vydělávat i bez aktivní práce. Například dividendy z akcií nebo pronájem nemovitostí.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"bda87444031cb6b48fd9057e","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"a35c6a8d82f835614bea2b58","lead":null,"label":"Podobné produkty","title":"Tím to *nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"3dfda823f91010601eb1b6e7","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"