{"docs":[{"id":2,"adminTitle":"V obchodě","title":"V obchodě","heroTitle":null,"description":null,"heroPhoto":null,"heroVideo":null,"heroStills":[],"heroPoints":[],"heroButtons":[],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"bce83d25607cf275dc7a9644","label":null,"photo":{"id":362,"alt":"Vzděláváme, jak „pomáhat lidem plnit sny“ a skrze tuto práci si plnit sny vlastní.","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:32.849Z","createdAt":"2026-11-02T14:21:32.849Z","url":"/allrisk-web-prototyp/media/allrisk-podpis-smlouvy.jpg","thumbnailURL":null,"filename":"allrisk-podpis-smlouvy.jpg","mimeType":"image/jpeg","filesize":451746,"width":1200,"height":800,"focalX":50,"focalY":50},"title":"Vzděláváme, jak „pomáhat lidem plnit sny“ a skrze tuto práci si plnit sny vlastní.","anchor":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[],"direction":"ltr","textStyle":"","textFormat":0},{"type":"block","fields":{"id":"6b3f9f78bb581de8b485d950","actions":[{"id":"6af45e8dfed2c9f4e6f8dfd6","url":"#kontakt","label":"Chci žít Allrisk","newTab":null,"variant":"primary","linkType":"url"}],"blockName":"","blockType":"buttons"},"format":"","version":2}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":null,"background":null,"signatures":[]},"format":"","version":2},{"type":"block","fields":{"id":"28bbb10cf09ad4c7cc8cf5da","cta":{"url":null,"label":null,"newTab":null,"linkType":"doc"},"lead":null,"image":null,"items":[{"id":"dfa5b5134d71d340103a27a5","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Společně pracujeme na tom, aby naše motto bylo odrazem života každého spolupracovníka. Vyvážený pracovní a osobní život. Dostatek času i finančních prostředků na život a plnění vlastních snů.","badge":null,"image":null,"title":"Životní styl"},{"id":"90861579438c0002610f0e41","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Náš obor se stal váženější profesí. Pomáháme lidem udělat si pořádek ve financích, aby si i oni mohli začít plnit sny. To je skvělé, nemyslíte?","badge":null,"image":null,"title":"Práce, která má smysl"},{"id":"66022dae4c9f0c5e8b0ae58a","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Jsme v oboru, který se neustále rozvíjí a nabízí zajímavé příležitosti. Neustále naše kolegy a spolupracovníky vzděláváme v oblasti obchodního, odborného a manažerského růstu.","badge":null,"image":null,"title":"Osobní růst"},{"id":"11d94ddbee516ef1efe44153","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Díky dlouhodobým vztahům a budování klientského kmene získáte příležitost tvořit si pasivní příjem. Ten můžete využít jak na odpočinek, tak i pro další investice nebo plnění svých snů.","badge":null,"image":null,"title":"Pasivní příjem"},{"id":"6e84c123592ba68e534196b9","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Práci si sestavíte přesně podle svých požadavků. Budete tak mít čas na rodinu, koníčky, dovolené i cestování. Svoboda je u nás v Allrisku na prvním místě.","badge":null,"image":null,"title":"Svoboda"},{"id":"a5ec2356b2036e604f5de200","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Máme hotové řešení pro stabilní a trvalý růst vašeho týmu, můžete si vybrat ze tří variant, které můžete dokonce volně kombinovat. Tvorba MLM sítě, koncipientský model nebo asistentský model.","badge":null,"image":null,"title":"Růst týmu"},{"id":"b864c283dcffef3eabb7077f","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Přinášíme stabilní zázemí a ideální podmínky pro podnikání a podporu v růstu. S námi začínáte v plusu a plníte si své podnikatelské sny.","badge":null,"image":null,"title":"Podnikatelský inkubátor"},{"id":"731a78a8483c5facb9d9304c","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":"Multioborovost, která vás nezatěžuje. skrze síť funkčních a sdílených služeb, které v platformě podnikání naleznete, můžete jako jednotlivec či tým zajistit svým klientům celý komplex sdílených služeb, aniž by vás to stálo jakýkoli čas navíc.","badge":null,"image":null,"title":"Komplexní řešení"}],"label":null,"title":"Proč vstoupit do platformy podnikání Allrisk?","anchor":null,"columns":"4","surface":"plain","variant":"tiles","blockName":null,"blockType":"cards","imageSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"f830c33aa1c716d5f781eb28","images":[{"id":363,"alt":"galavecer-allrisk-20-let","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:32.876Z","createdAt":"2026-11-02T14:21:32.876Z","url":"/allrisk-web-prototyp/media/galavecer-allrisk-20-let.jpg","thumbnailURL":null,"filename":"galavecer-allrisk-20-let.jpg","mimeType":"image/jpeg","filesize":105341,"width":1024,"height":682,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"type":"block","fields":{"id":"a34fc6bc99cbd09bd35fff59","images":[{"id":364,"alt":"onas-hero","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:32.917Z","createdAt":"2026-11-02T14:21:32.917Z","url":"/allrisk-web-prototyp/media/onas-hero.jpg","thumbnailURL":null,"filename":"onas-hero.jpg","mimeType":"image/jpeg","filesize":693989,"width":2560,"height":1706,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Podpora centrály Allrisk","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Autopůjčovna","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - naše vlastní půjčovna vozidel stabilně přes 400 vozidel, v průměru do 1 roku stáří. Zajišťuje našim klientům špičkový servis v případě nehody, a to dokonce i v situaci, že ji sami zavinili.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Likvidace pojistných událostí","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - oddělení, které pečuje o 100% spokojenost klientů při likvidaci pojistných událostí. Tato jedinečná služba i při větším počtu klientů obchodníka zaručí, že se obchodník stále věnuje obchodu a nemusí se věnovat likvidaci pojistných událostí.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"IT - HelpDesk","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - tým specialistů, který pečuje o počítače, tiskárny, telefony a další pomůcky jak přímo na centrále, tak umí pomoci i na dálku.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"IT - Vývoj","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - každý jedinečný produkt vyžaduje jedinečný software, několik vývojových týmů vytváří nové nástroje a zapracovává zpětné vazby uživatelů, ale také pečují o to, aby vše fungovalo jak má.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"block","fields":{"id":"6ca5d44c1feda27f8cb68dce","images":[{"id":365,"alt":"V obchodě","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:32.968Z","createdAt":"2026-11-02T14:21:32.968Z","url":"/allrisk-web-prototyp/media/leasing.jpg","thumbnailURL":null,"filename":"leasing.jpg","mimeType":"image/jpeg","filesize":1317149,"width":1440,"height":960,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Softwarová podpora","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - k efektivní práci v multioboru Allrisk jsou potřeba i externí nástroje a software, které pečlivě vybíráme a začleňujeme do Allrisk platformy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Právní zázemí","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - hladký průběh všech pracovních činností dnes zastřešuje kvalitní právní servis. Pomáhá nám v komunikaci a zapracováním legislativních norem a nařízení. Dále řeší veškeré kontroly úřadů a institucí a zapracovává změny legislativy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ekonomické zázemí","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - ekonomické oddělení se nad rámec běžných povinností stará o startupové podnikatelské platformy, které umíme našim poradenským týmům dodávat na klíč.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Metodická podpora","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - týmy metodiků a specialistů, kteří denně pracují na tom, aby se vám obchod dařil. Zajištují zpracování informací z trhu do modulu znalostní báze a v rámci obchodního cloudu aktualizují veškeré formuláře a podklady pro denní práci. Nadto jsou poradcům k dispozici na e-mailu i telefonu pro řešení neobvyklých situací.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"block","fields":{"id":"3439605b186e3bfe10096c22","images":[{"id":366,"alt":"V obchodě","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:33.006Z","createdAt":"2026-11-02T14:21:33.006Z","url":"/allrisk-web-prototyp/media/allrisk-odznacek.jpg","thumbnailURL":null,"filename":"allrisk-odznacek.jpg","mimeType":"image/jpeg","filesize":842795,"width":1200,"height":800,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obchodní oddělení","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - administrativní a provizní podpora obchodní sítě je tu pro hladký průběh celého procesu - od zpracování klientských smluv a dokumentů až po provize.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Akademie vzdělávání","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - vzdělávání je dnes základním stavebním kamenem růstu. Struktura akademie zaručuje, že jednotlivé vzdělávací bloky navazují a dostupný přehled dává kontext jak poradcům tak manažerům.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Marketingové oddělení","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - tým marketingového oddělení je nedílnou součástí podpory obchodní sítě ze strany centrály, a to zejména v oblasti budování PR, přípravy vizitek a dalších materiálů v oblasti osobní propagace, zajišťování a rozvíjení nabídky reklamních předmětů a tiskovin na interním e-shopu a přípravy materiálů na podporu prodeje. Organizuje také interní i externí eventy konané v rámci společnosti.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"block","fields":{"id":"af620c2497bd360bbd0e5c6b","images":[{"id":367,"alt":"V obchodě","visibility":"public","folder":1476,"updatedAt":"2026-11-02T14:21:33.040Z","createdAt":"2026-11-02T14:21:33.040Z","url":"/allrisk-web-prototyp/media/branch-meeting.jpg","thumbnailURL":null,"filename":"branch-meeting.jpg","mimeType":"image/jpeg","filesize":572702,"width":1200,"height":800,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"type":"block","fields":{"id":"73015123c0fef1df4f4680e5","cta":{"url":null,"label":null,"newTab":null,"linkType":"doc"},"lead":null,"image":null,"items":[{"id":"d75cb6a394b40eb5eababeba","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":null,"badge":null,"image":null,"title":"Ochrana vozidel"},{"id":"b1c063f328d02ccf36f80299","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":null,"badge":null,"image":null,"title":"Ochrana majetku"},{"id":"c1f29007582d0a6172b5f268","cta":{"url":null,"label":null,"newTab":null,"linkType":null},"icon":null,"text":null,"badge":null,"image":null,"tit