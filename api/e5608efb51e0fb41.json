pe":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Cestovní pojištění pro jednorázovou cestu -","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" toto pojištění poskytuje ochranu pro jednu konkrétní cestu, kterou plánujete podniknout.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Roční cestovní pojištění -","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" poskytuje krytí po celý rok pro více cest. Můžete vyrazit kamkoliv a kolikrát do roka budete chtít, počet výjezdů není nijak omezen. Tato varianta cestovního pojištění má dvě zásadní ","type":"text","style":"","detail":0,"format":0,"version":1},{"mode":"normal","text":"výhody:","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokud ročně v součtu vycestujete do zahraničí na více jak 10 dní, vyjde levněji než denní varianta.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nemusíte před každou cestou znovu řešit, zda a jak jste pojištění.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"e0b5756ea4c8f3473f74ef52","label":null,"photo":{"id":157,"alt":"Co vše může být zahrnuto v produktu cestovního pojištění:","visibility":"public","folder":1388,"updatedAt":"2026-11-02T14:21:15.203Z","createdAt":"2026-11-02T14:21:15.203Z","url":"/allrisk-web-prototyp/media/family-at-airport.jpg","thumbnailURL":null,"filename":"family-at-airport.jpg","mimeType":"image/jpeg","filesize":263040,"width":2560,"height":1435,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co vše může být zahrnuto v produktu cestovního pojištění:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění zdravotní péče v zahraničí a asistenční služby jsou automaticky zahrnuty do každého pojištění. Toto pojištění kryje náklady na nutnou zdravotní péči při náhlé nemoci nebo náklady na léky, za hospitalizaci, případně repatriaci nemocného nebo ostatků v případě smrti zpět do ČR. Asistenční služby - tedy pomoc v nouzi - fungují 24 hodin denně, vždy v českém jazyce.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Je možné a určitě doporučujeme připojistit si k tomuto základu i další rizika:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti - kryje náklady za škody, které během své cesty způsobíte třetím osobám na majetku, životě či zdraví","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění zavazadel - předmětem pojištění jsou vaše zavazadla, věci osobní potřeby, obchodní nebo sportovní vybavení pro případ poškození, zničení nebo odcizení","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Úrazové pojištění - poskytne finanční kompenzaci v případě smrti úrazem nebo trvalých následků v důsledku úrazu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění storna cesty - náhrada škody, která vám vznikne tím, že musíte z vážných zdravotních nebo rodinných důvodů zrušit plánovanou cestovní službu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"4c6e6b6f4787a4ed78b499ce","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"9db3cab37cda000adf0abc92","lead":null,"label":"Podobné produkty","title":"Cestovním pojištěním *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"a1b45da114e86beb2937d753","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání