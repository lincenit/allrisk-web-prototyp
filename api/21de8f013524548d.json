:null,"filename":"zivotni-pojisteni-hero.jpg","mimeType":"image/jpeg","filesize":365236,"width":2560,"height":1572,"focalX":50,"focalY":50},"menuTitle":"Život a úraz","summary":"Zajištění příjmu rodiny","icon":"IconHeartHandshake","isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání před dopady nečekaných událostí. Spolupracujeme s většinou pojišťoven na trhu, a tak vám i vaší rodině najdeme to nejvýhodnější krytí.","heroPhoto":150,"menuTitle":null,"summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","icon":"IconShield","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.887Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"zivot-a-uraz","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:40.698Z","createdAt":"2026-11-02T14:21:25.558Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"4fb179d6df3c021700b96f74","label":null,"photo":{"id":185,"alt":"Daňová zvýhodnění a pravidla DIPu:","visibility":"public","folder":1396,"updatedAt":"2026-11-02T14:21:16.381Z","createdAt":"2026-11-02T14:21:16.381Z","url":"/allrisk-web-prototyp/media/dip-photo.jpg","thumbnailURL":null,"filename":"dip-photo.jpg","mimeType":"image/jpeg","filesize":240237,"width":700,"height":392,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V čem se DIP liší od klasického penzijního připojištění","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V rámci penzijního připojištění nebo doplňkového penzijního spoření nemáte kontrolu nad tím, jak penzijní společnost s investovanými penězi nakládá. Naproti tomu v DIPu si můžete ideálně za podpory proškoleného odborníka nastavit investice podle svého uvážení a složení investic můžete v průběhu času libovolně měnit.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Od roku 2024 můžete mít jak své stávající penzijní připojištění, doplňkové penzijní spoření, tak i DIP, nebo dokonce několik DIPů, u různých společností.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Své naspořené finance z DIPu si můžete vybrat ve chvíli, kdy splňujete dvě podmínky - investice trvala minimálně 10 let a musí vám být alespoň 60 let věku. Částku si pak můžete vybrat buď jednorázově nebo postupně. Výběr nepodléhá zdanění, můžete tedy v investování pokračovat.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Daňová zvýhodnění a pravidla DIPu:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Každý rok si můžete odečíst ze základu daně celkem až 48 000 Kč za zdaňovací období. Tím ročně uspoříte na daních až 7 200 Kč.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Na DIP vám může přispívat i váš zaměstnavatel, stejně jako tomu bylo doposud u penzijního připojištění nebo životního pojištění. Zaměstnavatel si bude moct dát tyto příspěvky do nákladů coby daňově podporované produkty na stáří zaměstnance, a to až do výše 50 000 Kč ročně.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Znamená to, že maximální daňovou podporu od státu získáte, když si budete do DIPu posílat 4000 Kč.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"40973cf71982ea699b8b3b87","lead":null,"label":"Podobné produkty","title":"DIPem *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"d19be44f4f71422ca83bd696","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","heroTitle":null,"description":"Úvěry, investice i zajištění na penzi. Náš tým specialistů vyhodnotí vaši situaci a navrhne nejlepší řešení, ať si plníte sen o vlastním bydlení, nebo myslíte na budoucnost.","heroPhoto":{"id":152,"alt":"Finance","visibility":"public","folder":1385,"updatedAt":"2026-11-02T14:21:14.964Z","createdAt":"2026-11-02T14:21:14.964Z","url":"/allrisk-web-prototyp/media/financial-consultation.jpg","thumbnailURL":null,"filename":"financial-consultation.jpg","mimeType":"image/jpeg","filesize":389674,"width":2560,"height":1408,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Ú