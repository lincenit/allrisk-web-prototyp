:"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Náklady z námořního kasko pojištění","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Rybářské pojištění Allrisk","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" vás kryje v případě, kdy dojde ke škodě na pronajatých a zapůjčených věcech za účelem sportovního rybolovu. Tedy na motorových člunech, lodních šroubech, echolotech, GPS navigacích nebo také na rybářském vybavení. Všechny tyto věci jsou ze standardního cestovního pojištění přímo vyloučeny. A to i v případě, že má klient v rámci cestovního pojištění připojištěnou odpovědnost. Toto připojištění se totiž nevztahuje na jakékoli věci převzaté. Nejčastější drobné škody jsou právě ","type":"text","style":"","detail":0,"format":0,"version":1},{"mode":"normal","text":"na vybavení lodí a lodních šroubech","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"eea54be6b6856256fdd8024f","label":null,"photo":{"id":169,"alt":"Sjednání Rybářského pojištění Allrisk","visibility":"public","folder":1392,"updatedAt":"2026-11-02T14:21:15.738Z","createdAt":"2026-11-02T14:21:15.738Z","url":"/allrisk-web-prototyp/media/rybarske-pojisteni-photo.jpg","thumbnailURL":null,"filename":"rybarske-pojisteni-photo.jpg","mimeType":"image/jpeg","filesize":295922,"width":1707,"height":2560,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Sjednání Rybářského pojištění Allrisk","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Proto je tu pro vás naše Allrisk Rybářské pojištění. Umí to, co ostatní nechtějí (či neumí). Stačí vyplnit jednoduchý kontaktní formulář a my vám obratem připravíme nabídku.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Oblast A","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Sportovní rybolov po celé Evropě a lodě s výkonem do 50kW.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Oblast B","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Celý svět včetně tropických a severských oblastí za polárním kruhem a lodě s výkonem do 150kW.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V závislosti na cílové destinaci je unikátní Rybářské pojištění Allrisk rozdělené do několika kategorií. Jiné požadavky jsou totiž při rybolovu sumců ve Španělsku či Itálii a zcela odlišné jsou pro rybolov v blízkosti polárního kruhu či rovníku.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"6661808c90ce10b523b79e3f","items":[{"id":"21058e5bbfaaf9aa93f494ee","file":{"id":170,"alt":"smluvni_