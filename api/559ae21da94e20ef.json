"Tarif","surface":"card"},"format":"","version":2},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Rozsah krytí pro jednotlivé tarify se řídí všeobecnými pojistnými podmínkami ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"/allrisk-web-prototyp/media/vppcp-122018.pdf","newTab":true,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"VPPCP-2018","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"block","fields":{"id":"487511300be1556fe21885d2","items":[{"id":"28f79c0c02e12210d360e698","open":false,"title":"Proč bych si měl platit nadstandardní pojištění, když jedu na ryby?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Sportovní rybolov z lodi na otevřeném moři nepatří totiž do běžných sportů a většina pojišťoven ho tak má zařazený do rizikových sportů. Do této kategorie patří i rybolov za polárním kruhem nebo na rovníku. Můžete tedy doufat, že se Vám nic nestane, nebo si uzavřít náš produkt přímo pro tento koníček vytvořený.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"4136cbf9a3a6f4c2ac044ddf","open":false,"title":"Doteď jsem si pořizoval na cesty za rybolovem pouze klasické cestovní pojištění. To mi tedy na sportovní rybolov nestačí?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Standardní cestovní pojištění je vhodné na cestu či pobyt na pevnině, jakmile ale vyjedete na moře, nekryje jakoukoliv škodu, která vznikne při provozu plavidla, sportovním rybolovu, stejně tak jako nekryje škodu na lodi, vybavení a odpovědnost za škodu na zdraví cestujících na plavidle.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"2c8cbf8e85efa277f0ab15f7","open":false,"title":"Co když mám zlatou či platinovou platební kartu?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Stále se jedná o klasické cestovní pojištění jen s vyšším krytím.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"bce819568143b30255ca6727","open":false,"title":"Jsem potápěč a mám pojištění DAN. Pokryje mi všechna rizika, tedy i rybolov?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění DAN bohužel nekryje škody na lodi, vybavení a škodu na zdraví ostatních cestujících na plavidle.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"c3285ac594133a2543d39672","open":false,"title":"Máme na lodi vícečlennou posádku. Bude stačit, když si pojištění uzavře pouze jeden z nás?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokud dojde k jakékoliv nehodě, škodě na zdraví, životě nebo k zásahu SaR, bude krytí poskytnuto pouze tomu, který měl pojištění sjednáno. Ostatní členové posádky si veškeré náklady na léčení, transport, léky a ošetření, stejně jako zásah záchranných složek, hradí v plné výši.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"label":"Časté dotazy","title":"Odpovědi na vaše nejčastější otázky","anchor":null,"numbered":true,"blockName":"","blockType":"accordions"},"format":"","version":2},{"type":"block","fields":{"id":"8e5adf6dc06d3fc77d202e21","icon":null,"text":null,"claim":null,"title":"*Kontaktujte nás* pro více detailních informací o tomto unikátním produktu.","anchor":"sjednani","actions":[{"id":"6af45e88fed2c9f4e6f8dfd2","url":"tel:+420777167799","icon":"IconPhone","label":"+420 777 167 799","newTab":null,"linkType":"url"},{"id":"6af45e88fed2c9f4e6f8dfd3","url":"mailto:arp@allrisk.cz","icon":"IconMail","label":"arp@allrisk.cz","newTab":null,"linkType":"url"}],"variant":"band","blockName":null,"blockType":"banner"},"format":"","version":2},{"type":"block","fields":{"id":"3b35c0f2ae8e07d14b47a3af","lead":"Vyplňte prosím všechny údaje.","label":"Sjednání online","title":"Sjednejte si *Rybářské pojištění*","anchor":"sjednani","blockName":null,"blockType":"fishingForm","documents":[{"id":"a0718751f2275c1f23a8b4a3","file":{"id":170,"alt":"smluvni_ujednani_su_ck_cp_12-18.pdf","visibility":"public","folder":1393,"updatedAt":"2026-11-02T14:21:15.781Z","createdAt":"2026-11-02T14:21:15.781Z","url":"/allrisk-web-prototyp/media/smluvni-ujednani-su-ck-cp-12-18.pdf","thumbnailURL":null,"filename":"smluvni-ujednani-su-ck-cp-12-18.pdf","mimeType":"application/pdf","filesize":180464,"width":null,"height":null,"focalX":null,"focalY":null},"label":"Smluvní ujednání \"SZ 12/18 ke Smlouvě ARP\""},{"id":"ecbac901d2c0a6168006d989","file":{"id":171,"alt":"VPPCP%20122018.pdf","visibility":"public","folder":1393,"updatedAt":"2026-11-02T14:21:15.811Z","createdAt":"2026-11-02T14:21:15.811Z","url":"/allrisk-web-prototyp/media/vppcp-122018.pdf","thumbnailURL":null,"filename":"vppcp-122018.pdf","mimeType":"application/pdf","filesize":278525,"width":null,"height":null,"focalX":null,"focalY":null},"label":"Všeobecné pojistné podmínky cestovního pojištění \"VPPCP 12/2018\""},{"id":"c11