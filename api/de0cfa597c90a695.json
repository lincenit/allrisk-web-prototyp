hoto":{"id":189,"alt":"Výhody finančního leasingu","visibility":"public","folder":1398,"updatedAt":"2026-11-02T14:21:16.657Z","createdAt":"2026-11-02T14:21:16.657Z","url":"/allrisk-web-prototyp/media/leasing-podnikatele-photo.jpg","thumbnailURL":null,"filename":"leasing-podnikatele-photo.jpg","mimeType":"image/jpeg","filesize":853730,"width":1250,"height":833,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výhody finančního leasingu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pronájem na dobu: leasing obvykle funguje na dohodnutou dobu, která může být několik let. Po uplynutí této doby může nájemce buď vrátit pronajatý objekt, prodloužit dobu pronájmu, nebo v některých případech si předmět koupit za výhodnou cenu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Platby: nájemce platí pravidelné měsíční platby za právo používat pronajatý předmět. Tyto platby jsou obvykle nižší než úvěrové splátky, což může být pro nájemce výhodné.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vlastnictví: v průběhu doby leasingu zůstává vlastníkem předmětu leasingová společnost. Nájemce vlastní pouze právo k jeho užívání. Po skončení doby leasingu může mít nájemce možnost odkoupit objekt, pokud je to součástí dohody.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Flexibilita: leasing může být flexibilní způsob, jak získat potřebné vybavení nebo majetek bez velkých počátečních nákladů. Je vhodný i pro města a obce, které chtějí udržet svůj kapitál volný pro jiné investice.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Daňové výhody: v některých případech mohou být platby za leasing rychleji zdanitelné náklady než v případě nákupu předmětu, což může poskytnout daňové výhody pro města a obce.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"989294f5eeb9f646fa52e43f","lead":null,"label":"Podobné produkty","title":"Leasingem *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"903d0e80490b96c994e2fb40","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","heroTitle":null,"description":"Úvěry, investice i zajištění na penzi. Náš tým specialistů vyhodnotí vaši situaci a navrhne nejlepší řešení, ať si plníte sen o vlastním bydlení, nebo myslíte na budoucnost.","heroPhoto":{"id":152,"alt":"Finance","visibility":"public","folder":1385,"updatedAt":"2026-11-02T14:21:14.964Z","createdAt":"2026-11-02T14:21:14.964Z","url":"/allrisk-web-prototyp/media/financial-consultation.jpg","thumbnailURL":null,"filename":"financial-consultation.jpg","mimeType":"image/jpeg"