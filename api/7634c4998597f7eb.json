,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Máte-li toto pojištění, můžete se cítit klidnější, protože kdybyste potřebovali právní pomoc, pojišťovna vám může pomoci. Když máte problém a potřebujete právního zástupce (jako by to byl váš osobní superhrdina v právním světě), pojišťovna může platit za advokátní poplatky, soudní náklady a další věci, které by vás mohly stát spoustu peněz.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"477191ba4fbdb3ebe1c204e1","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"da9bf63d289908dc5e3e8a1a","lead":null,"label":"Podobné produkty","title":"Pojištěním právní ochrany *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"deab3485f427d27c7d639d97","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání před dopady nečekaných událostí. Spolupracujeme s většinou pojišťoven na trhu, a tak vám i vaší rodině najdeme to nejvýhodnější krytí.","heroPhoto":{"id":150,"alt":"Pojištění","visibility":"public","folder":1383,"updatedAt":"2026-11-02T14:2