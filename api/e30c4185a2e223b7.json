t":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"7 kroků pro úspěšnou realizaci:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"block","fields":{"id":"042e693d79ef9e3a0ed8b17d","items":[{"id":"9b6dd83d1e0a454ba88bb75f","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"1. Neprodávejte pod cenou","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vaši nemovitost oceníme nezávisle a ZDARMA. ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"doc":{"value":{"id":73,"_order":"b10","adminTitle":"Odhad tržní ceny nemovitosti","title":"Odhad tržní ceny nemovitosti","heroTitle":"Odhad *tržní ceny* nemovitosti","description":"Zjistěte reálnou tržní cenu vaší nemovitosti zdarma - report z aktuálních dat katastru a inzerce.","heroPhoto":{"id":261,"alt":"Odhad tržní ceny nemovitosti","visibility":"public","folder":1429,"updatedAt":"2026-11-02T14:21:22.967Z","createdAt":"2026-11-02T14:21:22.966Z","url":"/allrisk-web-prototyp/media/market-valuation-hero.jpg","thumbnailURL":null,"filename":"market-valuation-hero.jpg","mimeType":"image/jpeg","filesize":248681,"width":1920,"height":1080,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Reálná cena zdarma","icon":"IconChartBar","isActive":true,"parent":{"id":2,"_order":"a1","adminTitle":"Reality","title":"Reality","heroTitle":null,"description":"Od roku 2005 prodáváme, pronajímáme a vykupujeme byty, domy, chaty, pozemky i komerční nemovitosti. Jako součást Allrisku k tomu zajistíme financování, pojištění i úspory energií.","heroPhoto":151,"menuTitle":null,"summary":"Prodej, nákup i nájem - papírování necháte na nás.","icon":"IconBuildingEstate","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.948Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny"],"slug":"odhad-trzni-ceny","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:44.086Z","createdAt":"2026-11-02T14:21:27.131Z","_status":"published"},"relationTo":"allrisk-products"},"newTab":false,"linkType":"internal"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"Více informací zde","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"2. Navrhneme prodejní strategii","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Naši zkušení realitní makléři vytvoří strategii s ohledem na vaši situaci, typ nemovitosti, lokalitu se zacílením na vhodnou klientelu. Zvlášť u komerčních nemovitostí je prodejní strategie klíčová.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"3. Víme, co prodává","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Profesionální fotografie, videoprohlídky s grafickými prvky, pohledy z dronu, virtuální prohlídky a 3D scany nemovitostí ve spolupráci s výhradním zastoupením americké společnosti Matterport.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"4. Prodáváme aktivně","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kompletní inzerce na realitních webech je jen jedna ze součástí prodejní strategie. Na vaši nemovitost čekají klienti z naší databáze poptávajících. Zakázku nabízíme klientům z prohlídek na obdobných nemovitostí. Aktivně pracujeme s databází firem v oboru, pro které je nemovitost vhodná. Nečekáme. Kupujícího umíme najít.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"3157a01f1496c42039d220ae","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"5. Nic netajíme","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pravidelně vám předáváme přehled o počtech zhlédnutí zakázky, topování a dotazech klientů. Po prohlídce nemovitosti vždy obdržíte zpětnou vazbu klienta, ať už projeví zájem či nikoliv.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"6. Kompletní sada smluvní dokumentace","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vypracovaná advokátní kanceláří. U nás máte jistotu, že obchodní případ proběhne podle platných právních a daňových předpisů. Pro zabezpečení kupní ceny využíváme notářské či advokátní úschovy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"7. Prodejem to nekončí","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Realizací zakázky pro nás vztah s klientem nekončí. Zajistíme pro vás i další související služby spojené s prodejem nemovitosti. Například garantovanou úsporu na energiích nebo bonus 300 Kč na nezávaznou kontrolu finančních a pojistných produktů.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"perRow":"2","blockName":"","blockType":"columns"},"format":"","version":2},{"type":"block","fields":{"id":"f24b5603d3fa7aada526f142","lead":null,"label":"Podobné produkty","title":"Tím to *nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"9985b78c2d188a42656036e6","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"parent":{"id":2,"_order":"a1","adminTitle":"Reality","title":"Reality","heroTitle":null,"description":"Od roku 2005 prodáváme, pronajímáme a vykupujeme byty, domy, chaty, pozemky i komerční nemovitosti. Jako součást Allrisku k tomu zajistíme financování, pojištění i úspory energií.","heroPhoto":{"id":151,"alt":"Reality","visibility":"public","folder":1384,"updatedAt":"2026-11-02T14:21:14.910Z","createdAt":"2026-11-02T14:21:14.910Z","url":"/allrisk-web-prototyp/media/meridiem-slider.jpg","thumbnailURL":null,"filename":"meridiem-slider.jpg","mimeType":"image/jpeg","filesize":931961,"width":1077,"height":897,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Prodej, nákup i nájem - papírování necháte na nás.","icon":"IconBuildingEstate","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.948Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny","podnikatele"],"slug":"komercni-nemovitosti","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:44.224Z","createdAt":"2026-11-02T14:21:27.215Z","_status":"published"}