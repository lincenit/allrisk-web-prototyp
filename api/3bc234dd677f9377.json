ojištění","visibility":"public","folder":1410,"updatedAt":"2026-11-02T14:21:18.612Z","createdAt":"2026-11-02T14:21:18.612Z","url":"/allrisk-web-prototyp/media/do-pojisteni-hero.jpg","thumbnailURL":null,"filename":"do-pojisteni-hero.jpg","mimeType":"image/jpeg","filesize":876278,"width":1250,"height":833,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Odpovědnost vedení firmy","icon":"IconBriefcase","isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání před dopady nečekaných událostí. Spolupracujeme s většinou pojišťoven na trhu, a tak vám i vaší rodině najdeme to nejvýhodnější krytí.","heroPhoto":150,"menuTitle":null,"summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","icon":"IconShield","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.887Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["podnikatele"],"slug":"d-o-pojisteni","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:42.959Z","createdAt":"2026-11-02T14:21:26.547Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"e7a9f84e2aab365118863da0","label":null,"photo":{"id":230,"alt":"Průmyslová nebezpečí","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:19.225Z","createdAt":"2026-11-02T14:21:19.225Z","url":"/allrisk-web-prototyp/media/prumyslova-nebezpeci-hero.jpg","thumbnailURL":null,"filename":"prumyslova-nebezpeci-hero.jpg","mimeType":"image/jpeg","filesize":824513,"width":1200,"height":800,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jak vám pomůžeme","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Rádi bychom vám představili naše pojištění průmyslových nebezpečí, které je navržené tak, aby krylo náklady na opravu nebo nahrazení poškozených nebo ztracených budov, movitých věcí a zásob.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V našem pojištění jsme se zaměřili na tři hlavní oblasti:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kromě základních krytí máme také širokou škálu volitelných připojištění, která vám umožní přizpůsobit pojištění vašim potřebám a specifickým rizikům, se kterými se ve vašem podnikání můžete setkat.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění průmyslových nebezpečí je navrženo tak, aby vám poskytlo klid a jistotu, že váš majetek a odpovědnost jsou v bezpečí. Pokud máte zájem, rádi vám poskytneme další informace a poradíme vám s vhodným pojistným řešením pro váš podnik. Buďte v bezpečí s naším pojištěním!","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"bca65473a619d6d2f1713ad8","label":null,"photo":{"id":231,"alt":"Majetek","visibility":"public","folder":1414,"updatedAt":"2026-11-02T14:21:19.303Z","createdAt":"2026-11-02T14:21:19.303Z","url":"/allrisk-web-prototyp/media/prumyslova-nebezpeci-photo.jpg","thumbnailURL":null,"filename":"prumyslova-nebezpeci-photo.jpg","mimeType":"image/jpeg","filesize":844707,"width":800,"height":530,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Majetek","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato část pojištění kryje náklady na opravu nebo nahrazení budov, movitých věcí a zásob v důsledku různých pojistných událostí, jako jsou požáry, přímé údery bleskem, povodně, krupobití a další.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přerušení provozu","type":"text","style":"","detail":0,"format":1,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Pokud dojde k věcné škodě na vašem majetku, můžeme pokrýt finanční ztráty vzniklé v důsledku ztráty zisku, stálých nákladů a dalších souvisejících nákladů.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost","type":"text","style":"","detail":0,"format":1,"version":1},{"type":"linebreak","version":1},{"mode":"normal","text":"Tato část pojištění se týká povinnosti nahradit škodu nebo újmu, kterou můžete způsobit třetí osobě v důsledku vaší činnosti nebo právního vztahu. Pokrývá škody na majetku, újmy na zdraví, finanční škody a další.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2}