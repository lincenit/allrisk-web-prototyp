g","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co je možné zahrnout do ochrany nemovitosti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Budovy a jejich součásti:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" rodinný dům, byt v osobním vlastnictví, družstevní byt, rekreační chatu či chalupu, samostatnou garáž, k tomu pak lze připojistit vedlejší stavby na stejném místě - např. kůlna, garáž, bazén, altán, studna, oplocení, hospodářská budova, septik, opěrná zeď apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vnitřní vybavení:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" vybavení pevně spjaté s budovou, jako jsou vestavěné skříně, kuchyňské linky, podlahy a další interiérové prvky. Je důležité nezapomenout i na nadstandardní prvky jako jsou fotovoltaické a solární panely či tepelná čerpadla.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Proti jakým událostem lze ochranu uplatnit:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Proti krádeži: pojištění majetku, který byl odcizen při vloupání nebo krádeži","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Proti požáru: pojiš