í důvěryhodnosti AAA","visibility":"public","folder":1483,"updatedAt":"2026-11-02T14:21:41.687Z","createdAt":"2026-11-02T14:21:41.686Z","url":"/allrisk-web-prototyp/media/aaa-certificate.png","thumbnailURL":null,"filename":"aaa-certificate.png","mimeType":"image/png","filesize":72364,"width":606,"height":840,"focalX":50,"focalY":50},"title":"Devětkrát za sebou to nejvyšší *skóringové ocenění pro Allrisk*","anchor":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Certifikát potvrzuje spolehlivost, důvěryhodnost a minimální rizikovost spolupráce s naší společností. Hodnocení CZECH Stability Award AAA vyjadřuje současný stav a finanční situaci včetně predikce budoucího rizika a zároveň poskytuje nezávislý pohled na finanční a nefinanční bonitu firmy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nejvyšší ocenění AAA je udělováno na základě silného a nezávislého ratingu firem, jehož historie sahá až do roku 1908.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"$":{"color":"blue"},"mode":"normal","text":"2018 2019 2020 2021 2022 2023 2024 2025 2026","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"contain","blockName":"","blockType":"section","photoSide":null,"background":null,"signatures":[]},"format":"","version":2},{"type":"block","fields":{"id":"02828ff204308f1943df7859","label":"Ocenění","photo":{"id":524,"alt":"Certifikát Zaměstnavatel regionu 2020: Allrisk, a. s., 2. místo v kategorii do 500 zaměstnanců","visibility":"public","folder":1483,"updatedAt":"2026-11-02T14:21:41.715Z","createdAt":"2026-11-02T14:21:41.715Z","url":"/allrisk-web-prototyp/media/employer-award.png","thumbnailURL":null,"filename":"employer-award.png","mimeType":"image/png","filesize":587706,"width":562,"height":811,"focalX":50,"focalY":50},"title":"Allrisk. *Zaměstnavatel se stříbrným oceněním*","anchor":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Hodnocení Zaměstnavatel regionu se od roku 2003 zaměřuje na společnosti v České republice z pohledu lidských zdrojů. Smyslem soutěže je lidem přiblížit společnosti s výborným přístupem ke svým zaměstnancům, a to nejen celostátně, ale i v jednotlivých regionech.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Hodnocení probíhá metodikou Saratoga od mezinárodně uznávané společnosti PricewaterhouseCoopers, která nejprve porovnává firmy ve třech hlavních oblastech - HR, produktivitě a financích - a následně v dalších 14 ukazatelích. Druhé místo v regionálním kole Jihomoravského kraje v kategorii do 500 zaměstnanců potvrzuje stabilitu a čestnost Allrisku jako zaměstnavatele.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"contain","blockName":"","blockType":"section","photoSide":null,"background":null,"signatures":[]},"format":"","version":2},{"type":"block","fields":{"id":"daf61ec94e6deb09a7d680c2","cta":{"url":null,"label":null,"newTab":null,"linkType":"doc"},"lead":null,"image":null,"items":[{"id":"b0261ca8c1ca7b64670b2458","cta":{"url":null,"label":null,"newTab":null,"linkType":"doc"},"icon":"IconMapPin","text":"Brno","badge":null,"image":{"id":525,"alt":"Polyfunkční objekt Allrisk MERIDIEM","visibility":"public","folder":1483,"update