lrisk-pages"},"url":null,"label":"Všechny reference","newTab":null,"linkType":"doc"},"lead":null,"label":"Reference","limit":6,"title":"Co říkají *klienti*","total":null,"anchor":null,"blockName":null,"blockType":"references"},"format":"","version":2},{"type":"block","fields":{"id":"77157968e8784fe9b30be52a","items":[{"id":"2c17f091c354836e710753aa","open":false,"title":"Projde spolupráce s makléřem kontrolou?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ano. Obec za naše služby neplatí, odměnu hradí vybraný pojistitel z pojistného, takže nejde o veřejnou zakázku na poradenství. Celý průběh výběru dokumentujeme, aby byl doložitelný.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"5ac888af817fe8baff36a3d2","open":false,"title":"Jak vybíráte pojistitele?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Připravíme zadání podle skutečného majetku obce a oslovíme pojistitele na trhu. Nabídky porovnáme podle rozsahu krytí, výluk a spoluúčastí, ne jen podle ceny - a předložíme je s jasným doporučením.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"bdb858ccfab727ff3685133d","open":false,"title":"Za co ručí zastupitelé osobně?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Za škodu způsobenou při výkonu funkce, typicky nehospodárným rozhodnutím. Pojištění odpovědnosti kryje jak samotnou škodu, tak náklady na právní obhajobu, a to i po skončení mandátu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"591fc70a27e8ddc31582b373","open":false,"title":"Umíte pojistit i bytový fond obce?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ano. Bytové domy jsou samostatná část programu - živel, odpovědnost vlastníka i škody způsobené nájemníky. U nájmů nabízíme i službu Nájem bez rizika.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"95715aa3966c336ee60ea74e","open":false,"title":"Kdo řeší škodu, když se něco stane?","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"My. Máme vlastní Centrum likvidace, takže obec nepotřebuje mít člověka, který bude hlídat lhůty a dohadovat se s pojišťovnou o výši plnění. Stačí nám škodu nahlásit.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"label":"Časté dotazy","title":"Co se *nejčastěji ptáte*","anchor":null,"numbered":true,"blockName":"","blockType":"accordions"},"format":"","version":2},{"type":"block","fields":{"id":"35dec7b1533050fcc69b8177","lead":null,"label":"Blog","limit":4,"title":"Vysvětlujeme, *co se vyplatí vědět*","anchor":null,"rubric":null,"listing":null,"product":null,"blockName":null,"blockType":"posts"},"format":"","version":2},{"type":"block","fields":{"id":"701bfe97db6918415935c338","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"isActive":true,"segment":"mesta","slug":null,"translationState":null,"translationInput":n