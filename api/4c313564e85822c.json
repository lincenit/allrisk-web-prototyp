vně když se něco stane.","icon":"IconLifebuoy","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"servis","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:40.041Z","createdAt":"2026-11-02T14:21:25.232Z","_status":"published"},"segments":["rodiny"],"slug":"autopujcovna","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:42.126Z","createdAt":"2026-11-02T14:21:26.212Z","_status":"published"},{"id":48,"_order":"b0b","adminTitle":"Operativní leasing","title":"Operativní leasing","heroTitle":"Operativní *leasing*","description":"Nekupujte si nový vůz. Pronajměte si ho. Po skončení smlouvy ji můžete prodloužit anebo vozidlo vrátit a vyměnit ho za novější model.","heroPhoto":{"id":167,"alt":"Pojištění vozidel","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.648Z","createdAt":"2026-11-02T14:21:15.648Z","url":"/allrisk-web-prototyp/media/careffective-mondeo-2.jpg","thumbnailURL":null,"filename":"careffective-mondeo-2.jpg","mimeType":"image/jpeg","filesize":574582,"width":2560,"height":1707,"focalX":50,"focalY":50},"menuTitle":null,"summary":"Auto na paušál, vše v ceně","icon":"IconTruck","isActive":true,"parent":{"id":5,"_order":"a4","adminTitle":"Allrisk EFFECTIVE","title":"Allrisk EFFECTIVE","heroTitle":null,"description":"Program vlastních produktů Allrisk, který vám šetří peníze. Telefonujte s námi, využijte autopůjčovnu nebo k nám převeďte správu energií a získejte roční bonusy.","heroPhoto":154,"menuTitle":null,"summary":"Klubový projekt na snížení provozních nákladů.","icon":"IconSparkles","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"effective","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:40.083Z","createdAt":"2026-11-02T14:21:25.253Z","_status":"published"},"segments":["rodiny"],"slug":"operativni-leasing","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:42.652Z","createdAt":"2026-11-02T14:21:26.416Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"e69edad0889522bcbd25675f","label":null,"photo":{"id":165,"alt":"Inkasní systém Allrisk","visibility":"public","folder":1391,"updatedAt":"2026-11-02T14:21:15.576Z","createdAt":"2026-11-02T14:21:15.576Z","url":"/allrisk-web-prototyp/media/vozidla-collection-system.jpg","thumbnailURL":null,"filename":"vozidla-collection-system.jpg","mimeType":"image/jpeg","filesize":680981,"width":1000,"height":838,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Inkasní systém Allrisk","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V roce 2005 jsme na český trh přinesli jedinečný systém inkasního pojištění Allrisk. Díky globálnímu nákupu velkého množství produktů dosáhneme nejen optimální ceny, ale od každé pojišťovny nebo asistenční společnosti kupujeme jen ty produkty, které jsou prověřené trhem. Tyto produkty pak dle preferencí klienta poskládáme do balíčků, které svým obsahem zaručeně poskytují nejlepší poměr výkonu a ceny na trhu. Na pozadí celého projektu stojí obří IT zázemí, které vyvíjí a neustále zdokonaluje software Allrisk.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h3","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kategorie vozidel","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kategorie L","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Motorky, tříkolky","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kategorie M","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Osobní vozidla","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kategorie O","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Přípojná vozidla","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kategorie R","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" - Ostatní vozidla","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"0f22cfb89beff63e5f2f4dd2","label":null,"photo":{"id":166,"alt":"Autopojištění Allrisk","visibility":"public","folder":1391,"updatedAt":"2026-11-02T14:21:15.610Z","createdAt":"2026-11-02T14:21:15.610Z","url":"/allrisk-web-prototyp/media/vozidla-benefits.jpg","thumbnailURL":null,"filename":"vozidla-benefits.jpg","mimeType":"image/jpeg","filesize":265649,"width":600,"height":400,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obsah balíčku ZDARMA","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nad rámec základních produktů autopojištění jsou naší nejsilnější ochranou vozidel asistenční služby ZDARMA. ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"#veh-produkty","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"Více informací","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h3","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Sjednocené vyúčtování","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ať už máte 1 nebo 100 vozidel, máte vždy jedno jednoduché vyúčtování, které se vám vždy synchronizuje s kalendářním rokem. Sami klienti si určují frekvenci placení od měsíčních po roční platbu bez procentních poplatků za področní platby.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h3","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientský portál","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientský portál mujallrisk.cz poskytuje našim klientům ucelený přehled na všechny produkty a smlouvy inkasního pojištění Allrisk. Přihlášení a veškeré změny probíhají prostřednictvím SMS hesla, které je vázané na klientovo zaregistrované telefonní číslo. Důležitou součástí klientského portálu je přehled o pojistných událostech, které řešíte přes oddělení likvidace Allrisk.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"5aee05b96ca661a92ca647b3","lead":null,"tabs":[{"id":"77871a82d5c83fc7c41e35cb","tag":"Ze zákona povinné","icon":"IconShield","lead":"Pojištění odpovědnosti z provozu vozidla, které musí ze zákona mít každý provozovatel vozidla. V případě nehody, kterou zaviníte, se postará o úhradu způsobených škod na zdraví a majetku třetích osob.","note":"Limit krytí volíte vy - od zákonných 50 mil. Kč přes 100 mil. až po 1 miliardu Kč. Povinné ručení ale nekryje škody na vašem vlastním voze ani jeho odcizení - na to slouží havarijní pojištění.","label":"Povinné ručení","covers":[{"id":"711b56267d8462457ff90918","text":"Škody na zdraví třetích osob"},{"id":"a70240711ed066367707c24f","text":"Škody na cizím majetku"},{"id":"650ed52d4e802ab72cefb09d","text":"Asistenční služby v základu"},{"id":"eb689b499c5bf54ee3c82958","text":"Zelená karta pro cesty do zahraničí"}]},{"id":"78458c850212ade4d3b16f44","tag":"Chrání vaše auto","icon":"IconCarCrash","lead":"Ochranný štít pro vaše vozidlo pro případ nehody, poškození i odcizení. Pokryje veškeré náklady na váš vůz - opravy, nové díly, odtah i zapůjčení náhradního vozu po dobu opravy v servisu.","note":"Při sjednání si pohlídejte územní platnost, výši pojistné částky a spoluúčasti - některé pojišťovny zlevňují produkt právě omezováním těchto parametrů.","label":"Havarijní pojištění","covers":[{"id":"a73cabcab4f4d807b463b4b4","text":"Poškození vlastního vozu při nehodě"},{"id":"cea9da78b4c60ba080712a83","text":"Odcizení vozidla"},{"id":"eeb14911ff2a6290ebf09e3c","text":"Vandalismus a živelní události"},{"id":"fc9a0ccddb21674a874d3d34","text":"Náhradní vůz po dobu opravy"}]},{"id":"23663e08cc6e6c5ba11b658b","tag":"Připojištění","icon":"IconWindow","lead":"Oprava nebo výměna čelního i ostatních skel bez velkých výdajů. Drobné prasklinky vyřešíme rychle a často bez vlivu na vaše ostatní pojištění.","note":"Drobná prasklina = rychlá oprava na počkání, často bez vlivu na bonus.","label":"Pojištění skel","covers":[{"id":"faa7fa8768a564d7dfce7fdb","text":"Čelní sklo"},{"id":"611e6c839b3e461dfc95d39c","text":"Boční a zadní skla"},{"id":"5c4c908d873b727f77de0e94","text":"Oprava často bez spoluúčasti"}]},{"id":"eea04bd6e51925b964332d06","tag":"Připojištění","icon":"IconTool","lead":"Pomoc na cestě 24/7, 365 dní v roce - v ČR i v zahraničí. Odtah do servisu, oprava na místě, náhradní vozidlo i ubytování, když se vůz porouchá daleko od domova.","note":"Limit asistence můžete zvýšit nálepkou Allrisk - nalepíte ji na vůz, pošlete foto se SPZ a do 5 pracovních dnů ji aktivujeme zdarma.","label":"Technické asistence","covers":[{"id":"df15ea995b0c41682f63f434","text":"Odtah a vyproštění vozidla"},{"id":"14916a0f5fe2220b666a232b","text":"Oprava na místě - baterie, palivo, odemčení"},{"id":"4f72ec7ea25ef99e57e745dd","text":"Náhradní vozidlo nebo ubytování"},{"id":"1398871fba569aec2eb99efa","text":"Non-stop dispečink a právní pomoc"}]},{"id":"9150d62937631f076274425e","tag":"Připojištění","icon":"IconRoute","lead":"Až 80 % vozidel nemá dostatečné limity technické asistence. Ochrana na cestách je zvýší přesně na dobu, kdy je potřebujete - na výlet i dovolenou autem, doma i v zahraničí.","note":"Pro klienty s autopojištěním Allrisk aktivujete na 20 dní za 199 Kč přímo v portálu mujallrisk.cz - klidně i dopředu na plánovanou cestu.","label":"Ochrana na cestách","covers":[{"id":"f3679e528663a41162ea15ef","text":"Vyšší limity asistence - 10 000 Kč v ČR, 40 000 Kč v zahraničí"},{"id":"82bd71713c3b7b594a44a6ed","text":"Ubytování i doprava posádky na cestě"},{"id":"7fa649084cce021b125d64e9","text":"Delší uskladnění a odtah vozidla"},{"id":"d37ad18deeb24d981c576d0c","text":"Asistence při odcizení vozu"}]}],"label":"Co lze sjednat","title":"Vše k autu na *jedné stránce*","anchor":"veh-produkty","blockName":null,"blockType":"coverage","categories":[]},"format":"","version":2},{"type":"block","fields":{"i