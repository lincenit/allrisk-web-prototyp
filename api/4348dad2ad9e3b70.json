RL":null,"filename":"zivotni-pojisteni-hero.jpg","mimeType":"image/jpeg","filesize":365236,"width":2560,"height":1572,"focalX":50,"focalY":50},"menuTitle":"Život a úraz","summary":"Zajištění příjmu rodiny","icon":"IconHeartHandshake","isActive":true,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění vás chrání před dopady nečekaných událostí. Spolupracujeme s většinou pojišťoven na trhu, a tak vám i vaší rodině najdeme to nejvýhodnější krytí.","heroPhoto":150,"menuTitle":null,"summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","icon":"IconShield","isActive":true,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:39.887Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"zivot-a-uraz","translationState":null,"translationInput":null,"updatedAt":"2026-11-11T12:24:40.698Z","createdAt":"2026-11-02T14:21:25.558Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"3e7a838475080118405b2eb8","label":null,"photo":{"id":193,"alt":"Penzijní spoření","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.925Z","createdAt":"2026-11-02T14:21:16.925Z","url":"/allrisk-web-prototyp/media/penzijni-sporeni-photo.jpg","thumbnailURL":null,"filename":"penzijni-sporeni-photo.jpg","mimeType":"image/jpeg","filesize":860609,"width":1250,"height":833,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jak vám pomůžeme","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato forma spoření slouží k doplnění státního důchodu a umožňuje občanům navyšovat své příjmy po dosažení důchodového věku. Doplňkové penzijní spoření bylo zavedeno v roce 2013 a je organizováno pod záštitou Penzijního fondu České pojišťovny.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"77fbd2373c06c88bf24d94a6","label":null,"photo":{"id":194,"alt":"Výhody","visibility":"public","folder":1400,"updatedAt":"2026-11-02T14:21:16.993Z","createdAt":"2026-11-02T14:21:16.993Z","url":"/allrisk-web-prototyp/media/penzijni-sporeni-hero.jpg","thumbnailURL":null,"filename":"penzijni-sporeni-hero.jpg","mimeType":"image/jpeg","filesize":775832,"width":1250,"height":833,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výhody","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Státní příspěvek až 2 760 Kč ročně,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Úspora na daních až 3 600 Kč ročně,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Žádné vstupní poplatky, sjednání je zdarma,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přispívat vám může i zaměstnavatel,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Spořit můžete i dětem.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Fungování doplňkových penzijních spoření","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Osobní volba fondu:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" každý občan, který začne pracovat, je automaticky zařazen do systému doplňkového penzijního spoření. Má však možnost si vybrat konkrétní penzijní fond, do kterého budou směřovány jeho příspěvky. Existuje několik penzijních fondů, které spravují peníze účastníků a investují je s cílem dosáhnout co nejlepšího zhodnocení.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příspěvky:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" každý účastník DPS povinně odvádí určitý procentní podíl ze své hrubé mzdy (osobní příspěvek). K tomu se přidává ještě státní příspěvek, který je závislý na výši osobního příspěvku. Čím více účastníků spoří, tím větší podíl státního příspěvku obdrží. Státní příspěvek je limitován určitou částí.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Investování:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" penzijní fondy investují shromážděné finanční prostředky do různých aktiv, jako jsou akcie, dluhopisy, nemovitosti atd. Cílem je dosáhnout co nejlepšího zhodnocení a zvýšit hodnotu spoření účastníků.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"114ebd90aa3fa47e9e813449","label":null,"photo":{"id":195,"alt":"Důchodový věk:","visibility":"public","folder":1400,"updatedAt":"2026-11-02T14:21:17.040Z","createdAt":"2026-11-02T14:21:17.040Z","url":"/allrisk-web-prototyp/media/penzijni-sporeni-produkt2.jpg","thumbnailURL":null,"filename":"penzijni-sporeni-produkt2.jpg","mimeType":"image/jpeg","filesize":999104,"width":1250,"height":834,"focalX":50,"focalY":50},"title":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Důchodový věk:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":" po dosažení důchodového věku má účastník možnost si nechat vyplácet peníze, které spořil. Může si vybrat, zda chce peníze jako jednorázové vyplacení, nebo chce pravidelně měsíční příjem, který mu bude vyplácen až do konce života.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Daňové výhody:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" doplňkové penzijní spoření je spojeno s daňovými výhodami. Příspěvky do penzijního fondu mohou být odečteny z hrubé mzdy, což znamená, že se na ně neplatí daně. Daně budou placeny až při vyplácení penze.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přenosnost:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" pokud se účastník rozhodne změnit penzijní fond, může to udělat bez poplatků a ztráty dosavadních příspěvků.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Omezení výběru:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" doplňkové penzijní spoření má určitá omezení, například není možné vybrat si peníze před dosažením důchodového věku, pokud účastník není postižen závažnou nemocí nebo nezemře.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Je důležité si přečíst informace o různých penzijních fondech, jejich poplatcích, investičních strategiích a dalších podmínkách, abyste mohli rozhodnout, který fond je pro vás vhodný.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příklady z praxe","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vstupní věk klienta 45 let s horizontem 20 let vám 100 Kč vydělá 116 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,