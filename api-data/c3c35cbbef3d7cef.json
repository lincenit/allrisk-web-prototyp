","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.283Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"odpovednost","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.745Z","createdAt":"2026-11-02T14:21:25.343Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"3f761bc45cf215761ea87793","photo":{"id":203,"filename":"uvery-na-bydleni-photo.jpg","alt":"Starosti nechte na nás","visibility":"public","folder":1404,"updatedAt":"2026-11-02T14:21:17.623Z","createdAt":"2026-11-02T14:21:17.623Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/uvery-na-bydleni-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":735406,"width":1500,"height":1127,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Podobné podmínky ve všech bankách","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Úvěry na bydlení za velice podobných podmínek nabízejí dnes prakticky veškeré bankovní domy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Představa řady klientů, že díky tomu, že mají svůj běžný účet v jedné bance, jim pomůže zlepšit podmínky úvěru na bydlení, již řadu let neplatí. Dokonce opakovaná neúspěšná žádost ve více bankách vám může zásadně zhoršit vyjednávací pozici.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Starosti nechte na nás","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Než půjdete jakoukoli banku žádat, ve spolupráci s našimi specialisty zjistíte dříve, jestli a kde budou vaše možnosti nejlepší. Pomůžeme vám vše připravit - a pokud to situace vyžaduje - zkombinovat několik variant pro nejlepší možné řešení.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"U mladších klientů máme program, jak se mohou několik let připravovat na pořízení vlastního bydlení za co nejlepších podmínek na trhu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Velkou pomocí v naší péči o klienty je speciální srovnávač napojený na aktuální podmínky všech bank, který našim specialistům pomáhá mít vždy ty nejaktuálnější informace z celého trhu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"3683800e36587a2a69db81d6","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"1f309944877a13241a836489","lead":null,"label":"Podobné produkty","title":"Úvěry na bydlení *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"6fcc0be7801b6f7bf2028fe7","anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","menuTitle":null,"icon":"IconCoins","summary":"Úvěry, investice a účty srovnané napříč trhem.","cardPhoto":null,"heroTitle":null,"description":"Rodinné finance zahrnují veškeré finanční aspekty našeho života. Jejich správa není vždy jednoduchá, a proto máme tým zkušených specialistů, který je připravený vyhodnotit vaši situaci a navrhnout nejlepší kombinaci správy a investic vašich financí.","heroPhoto":{"id":152,"filename":"financial-consultation.jpg","alt":"Finance","visibility":"public","folder":1385,"updatedAt":"2026-11-02T14:21:14.964Z","createdAt":"2026-11-02T14:21:14.964Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/financial-consultation.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":389674,"width":2560,"height":1408,"focalX":50,"focalY":50},"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"finance","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.385Z","createdAt":"2026-11-02T14:21:25.213Z","_status":"published"},"segments":["rodiny"],"slug":"uvery-na-bydleni","externalUrl":null,"updatedAt":"2026-11-26T12:04:46.460Z","createdAt":"2026-11-02T14:21:26.177Z","_status":"published"}],"hasNextPage":false,"hasPrevPage":false,"limit":20,"nextPage":null,"page":1,"pagingCounter":1,"prevPage":null,"totalDocs":1,"totalPages":1}