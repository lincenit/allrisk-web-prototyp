{"docs":[{"id":39,"_order":"b02","adminTitle":"Úvěry na bydlení","title":"Úvěry na bydlení","menuTitle":null,"icon":"IconBuildingBank","summary":"Hypotéka i refinancování","cardPhoto":null,"heroTitle":"Úvěry na *bydlení*","description":"Bankovní úvěr na bydlení je stále nejefektivnější cestou, jak řešit prostředky k pořízení nemovitosti. Tuto službu za velice podobných podmínek nabízejí prakticky veškeré bankovní domy.","heroPhoto":{"id":202,"filename":"uvery-na-bydleni-hero.jpg","alt":"Úvěry na bydlení","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:17.477Z","createdAt":"2026-11-02T14:21:17.477Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/uvery-na-bydleni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":971582,"width":1700,"height":1277,"focalX":50,"focalY":50},"heroVideo":null,"heroStills":[],"heroPoints":[{"id":"15424a6ca5e5ae10c460ae54","icon":"IconHome","text":"Přímá cesta k vlastnímu bydlení"},{"id":"6e4bf21be0a337e736fd6302","icon":"IconChecklist","text":"Doporučíme nejvhodnější řešení"},{"id":"e7a4629980924719428db419","icon":"IconScale","text":"Aktuální informace z trhu"}],"heroButtons":[{"id":"8fe8e0e65924bf173f12b9b9","icon":null,"iconAfter":"IconArrowUpRight","variant":"primary","url":"#kontakt","newTab":null,"label":"Chci tento produkt"}],"similar":[{"id":6,"_order":"a5","adminTitle":"Pojištění majetku","title":"Pojištění majetku","menuTitle":"Majetek","icon":"IconHome","summary":"Nemovitost i domácnost","cardPhoto":null,"heroTitle":"Pojištění *majetku*","description":"„Můj dům, můj hrad“. Pojištění domácnosti je často klienty opomíjeno, jelikož se domnívají, že v pojištění nemovitosti již mají vše. Nicméně jsou to zcela rozdílné produkty.","heroPhoto":{"id":155,"filename":"pojisteni-nemovitosti-hero.jpg","alt":"Pojištění nemovitosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.121Z","createdAt":"2026-11-02T14:21:15.121Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-ne