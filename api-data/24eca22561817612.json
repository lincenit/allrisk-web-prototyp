rvis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.283Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["podnikatele"],"slug":"d-o-pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:47.034Z","createdAt":"2026-11-02T14:21:26.547Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"57100080e72440d08c5dd2d5","photo":{"id":238,"filename":"prepravni-pojisteni-hero.jpg","alt":"Přepravní pojištění","visibility":"public","folder":1418,"updatedAt":"2026-11-02T14:21:19.773Z","createdAt":"2026-11-02T14:21:19.773Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prepravni-pojisteni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":853854,"width":1250,"height":607,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ochrana zásilek po celou cestu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Naše pojištění je navrženo tak, aby krylo rizika, která mohou vzniknout během přepravy zboží jakoukoli formou dopravy, ať už se jedná o silniční, leteckou, lodní nebo železniční. S důrazem na spolehlivost, rychlost a flexibilitu vám naše pojištění umožní mít jistotu, že vaše zásilky jsou v bezpečí po celou dobu své cesty. Připojte se k nám a dejte vašim zásilkám tu nejlepší ochranu, kterou si zaslouží.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"f5fa21c350c508f5f24a5f47","photo":{"id":239,"filename":"prepravni-pojisteni-photo.jpg","alt":"Pojištění odpovědnosti silničního dopravce","visibility":"public","folder":1418,"updatedAt":"2026-11-02T14:21:19.806Z","createdAt":"2026-11-02T14:21:19.806Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prepravni-pojisteni-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":824173,"width":1200,"height":675,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V této kategorii nabízíme několik produktů","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti silničního dopravce","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pro podnikatele, kteří provozují vnitrostátní nebo mezinárodní silniční dopravu na základě platné koncesní listiny, tj. ti, kteří zajišťují dopravu pro cizí potřeby.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokrývá případy, kdy jste jako silniční dopravce povinni nahradit škodu způsobenou na přepravovaných hmotných věcech.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti zasílatele","type":"text","style":"","detail":0,"format":1,"vers