:1418,"updatedAt":"2026-11-02T14:21:19.773Z","createdAt":"2026-11-02T14:21:19.773Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prepravni-pojisteni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":853854,"width":1250,"height":607,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Naše pojištění je navrženo tak, aby krylo rizika, která mohou vzniknout během přepravy zboží jakoukoli formou dopravy, ať už se jedná o silniční, leteckou, lodní nebo železniční. S důrazem na spolehlivost, rychlost a flexibilitu vám naše pojištění umožní mít jistotu, že vaše zásilky jsou v bezpečí po celou dobu své cesty. Připojte se k nám a dejte vašim zásilkám tu nejlepší ochranu, kterou si zaslouží.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V této kategorii nabízíme několik produktů","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"f5fa21c350c508f5f24a5f47","photo":{"id":239,"filename":"prepravni-pojisteni-photo.jpg","alt":"Pojištění odpovědnosti silničního dopravce","visibility":"public","folder":1418,"updatedAt":"2026-11-02T14:21:19.806Z","createdAt":"2026-11-02T14:21:19.806Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prepravni-pojisteni-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":824173,"width":1200,"height":675,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti silničního dopravce","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pro podnikatele, kteří provozují vnitrostátní nebo mezinárodní silniční dopravu na základě platné koncesní listiny, tj. ti, kteří zajišťují dopravu pro cizí potřeby.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokrývá případy, kdy jste jako silniční dopravce povinni nahradit škodu způsobenou na přepravovaných hmotných věcech.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti zasílatele","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Toto pojištění je určeno podnikatelům provozujícím vnitrostátní nebo mezinárodní zasílatelství, kteří se zavazují dopravit věci pro cizí potřeby prostřednictvím cizích dopravců.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokrývá případy, kdy jste jako silniční dopravce povinni nahradit škodu způsobenou na přepravovaných hmotných věcech.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění cenností během přepravy","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","