{"docs":[{"id":17,"adminTitle":"Rozšiřujeme a modernizujeme naše pobočky","title":"Rozšiřujeme a modernizujeme *naše pobočky*","perex":"Představujeme vám naše nové pobočky i přeměnu do nového designu.","cover":{"id":322,"filename":"pobocky-cr-a-sr-2026-cover.png","alt":"Pobočky ČR a SR","visibility":"public","folder":1464,"updatedAt":"2026-11-02T14:21:30.672Z","createdAt":"2026-11-02T14:21:30.672Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pobocky-cr-a-sr-2026-cover.png","thumbnailURL":null,"mimeType":"image/png","filesize":521726,"width":800,"height":414,"focalX":50,"focalY":50},"rubric":"firma","publishedAt":"2025-10-17T11:20:32.000Z","readMinutes":1,"author":null,"product":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Blíž našim klientům","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Chceme být našim klientům blíž, a proto postupně otevíráme nová klientská centra a obchodní kanceláře tam, kde jsme dosud neměli stálé zastoupení. Nově nás najdete například v Kostelci nad Orlicí a Rousínově u Vyškova. Proměnou však procházejí i naše stávající pobočky, které získávají moderní design a komfortní prostředí, aby byla každá schůzka příjemná","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientské centrum v Kostelci nad Orlicí","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Čerstvě jsme pro vás otevřeli nové klientské centrum v Kostelci nad Orlicí v Královéhradeckém kraji. Pomůžeme vám zde se všemi oblastmi portfolia Allrisk - od pojištění, financí, realit až po investice a zvýhodněné balíčky telefonování či energií. Najdete nás na adrese Palackého náměstí 21.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obchodní kancelář Rousínov u Vyškova","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Další nově otevřenou pobočkou je naše pojišťovací, realitní, hypoteční a investiční centrum v Rousínově u Vyškova. Najdete nás na adrese Čechyně 102, kde vám nabízíme kompletní servis na jednom místě.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"block","fields":{"id":"ff62249c8fc329171de824f2","images":[{"id":323,"filename":"allrisk-magazin-2026-pobocky2.png","alt":"allrisk-magazin-2026-pobocky2","visibility":"public","folder":1464,"updatedAt":"2026-11-02T14:21:30.707Z","createdAt":"2026-11-02T14:21:30.707Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/allrisk-magazin-2026-pobocky2.png","thumbnailURL":null,"mimeType":"image/png","filesize":667585,"width":800,"height":451,"focalX":50,"focalY":50}],"linked":false,"videos":[],"columns":"3","blockName":"","blockType":"media","linkType":"doc"},"format":"","version":2},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nový design pro stávající pobočky","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Allrisk přichází s celoplošným redesignem, který postupně zavádíme na všech našich pobočkách. Brzy si tak všimnete modernějšího a svěžejšího vzhledu, který přináší větší komfort a příjemnější prostředí pro naše setkávání.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nový vizuální styl odráží naši hlavní myšlenku - být vám partnerem na každé cestě a v jakékoliv životní situaci. Změny se netýkají pouze vnější podoby našich budov, ale postupně zasahují i do samotných interiérů, které chceme přetvořit tak, aby v každém detailu odrážely otevřenost, profesionalitu a přátelský charakter naší společnosti.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Aktuálně připravujeme:","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientské centrum Pardubice","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientské centrum v Kloboukách u Brna","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientské centrum v Hradci Králové","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obchodní kancelář Praha - Litvínovská","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kontaktní místo v Rychnově nad Kněžnou","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"isActive":true,"slug":"pobocky-cr-a-sr-2026","translationState":null,"translationInput":null,"updatedAt":"2026-11-02T14:21:32.207Z","createdAt":"2026-11-02T14:21:32.207Z","_status":"published"}],"hasNextPage":false,"hasPrevPage":false,"limit":1,"nextPage":null,"page":1,"pagingCounter":1,"prevPage":null,"totalDocs":1,"totalPages":1}