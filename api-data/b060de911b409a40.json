{"docs":[{"id":9,"_order":"a8","adminTitle":"Pojištění občanské odpovědnosti","title":"Pojištění občanské odpovědnosti","heroTitle":"Pojištění *odpovědnosti z občanského života*","description":"Pojištění odpovědnosti z občanského života je typ pojištění chránící před finančními náklady, které způsobíte třetím osobám nebo jejich majetku. Toto pojištění může být velmi užitečné, protože některé škody a důsledky z nich mohou být nečekaně drahé.","heroPhoto":{"id":160,"filename":"odpovednost-hero.jpg","alt":"Pojištění občanské odpovědnosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.313Z","createdAt":"2026-11-02T14:21:15.313Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/odpovednost-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":422865,"width":2560,"height":1707,"focalX":50,"focalY":50},"heroVideo":null,"heroStills":[],"heroPoints":[{"id":"01f010a513208b9ed7c83a1b","icon":"IconUsers","text":"Chrání osoby"},{"id":"61b4916c6058ac324f62d99b","icon":"IconShield","text":"Pojistí škody v domácnosti"},{"id":"b095358786b352c79eb9f52b","icon":"IconPaw","text":"Kryje škody způsobené dětmi a mazlíčky"}],"heroButtons":[{"id":"205cf1a15ba8c206dff23867","icon":null,"iconAfter":"IconArrowUpRight","variant":"primary","url":"#kontakt","newTab":null,"label":"Chci tento produkt"},{"id":"45094c233e78bd6b9f39d5ae","icon":null,"iconAfter":null,"variant":"outline","url":"/kontakty","newTab":null,"label":"Kontakty a pobočky"}],"menuTitle":"Odpovědnost","icon":"IconShield","summary":"„Blbinka“ v běžném životě","cardPhoto":null,"similar":[{"id":10,"_order":"a9","adminTitle":"Pojištění právní ochrany","title":"Pojištění právní ochrany","heroTitle":"Pojištění *právní ochrany*","description":"Pojištění právní ochrany je jako druh „záloh“ pro jednotlivce i rodiny pro případ, že byste se ocitli v právním problému.","heroPhoto":{"id":162,"filename":"pravni-ochrana-hero.jpg","alt":"Pojištění právní ochrany","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.407Z","createdAt":"2026-11-02T14:21:15.407Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pravni-ochrana-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":269415,"width":2560,"height":1706,"focalX":50,"focalY":50},"menuTitle":"Právní ochrana","icon":"IconScale","summary":"Spory a zastoupení","cardPhoto":null,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-21T21:18:03.674Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"pravni-ochrana","externalUrl":null,"updatedAt":"2026-11-23T22:53:42.652Z","createdAt":"2026-11-02T14:21:25.369Z","_status":"published"},{"id":16,"_order":"af","adminTitle":"Životní a úrazové pojištění","title":"Životní a úrazové pojištění","heroTitle":"*Životní a úrazové* pojištění","description":"Životní a úrazové pojištění poskytuje důležitou finanční ochranu pro vás a vaši rodinu v případě nečekaných událostí.","heroPhoto":{"id":178,"filename":"zivotni-pojisteni-hero.jpg","alt":"Životní a úrazové pojištění","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.020Z","createdAt":"2026-11-02T14:21:16.020Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/zivotni-pojisteni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":365236,"width":2560,"height":1572,"focalX":50,"focalY":50},"menuTitle":"Život a úraz","icon":"IconHeartHandshake","summary":"Zajištění příjmu rodiny","cardPhoto":null,"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-21T21:18:03.674Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"zivot-a-uraz","externalUrl":null,"updatedAt":"2026-11-23T22:53:42.888Z","createdAt":"2026-11-02T14:21:25.558Z","_status":"published"},{"id":77,"_order":"b14","adminTitle":"Pojištění domácnosti","title":"Pojištění domácnosti","heroTitle":"Pojištění *domácnosti*","description":"Pojištění domácnosti je často klienty opomíjeno, jelikož se domnívají, že v pojištění nemovitosti již mají vše. Nicméně jsou to zcela rozdílné produkty.","heroPhoto":{"id":269,"filename":"pojisteni-domacnosti-hero.jpg","alt":"Pojištění domácnosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:24.885Z","createdAt":"2026-11-02T14:21:24.885Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-domacnosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":725806,"width":1250,"height":833,"focalX":50,"focalY":50},"menuTitle":"Domácnost","icon":"IconArmchair","summary":"Vybavení a věci uvnitř","cardPhoto":null,"parent":{"id":6,"_order":"a5","adminTitle":"Pojištění majetku","title":"Pojištění majetku","heroTitle":"Pojištění *majetku*","description":"„Můj dům, můj hrad“. Pojištění nemovitosti je zaměřeno na ochranu samotné budovy a souvisejících staveb na tomtéž pozemku. Tímto druhem pojištění lze pojistit budovu již ve fázi výstavby.","heroPhoto":155,"menuTitle":"Majetek","icon":"IconHome","summary":"Nemovitost i domácnost","cardPhoto":null,"parent":1,"segments":["rodiny","podnikatele"],"slug":"majetek","externalUrl":null,"updatedAt":"2026-11-23T19:21:11.999Z","createdAt":"2026-11-02T14:21:25.275Z","_status":"published"},"segments":["rodiny"],"slug":"domacnost","externalUrl":null,"updatedAt":"2026-11-23T19:14:50.570Z","createdAt":"2026-11-02T14:21:27.251Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"b2879b040162ce17dd928bac","photo":{"id":161,"filename":"pojisteni-obcanske-odpovednosti.jpg","alt":"Pojištění odpovědnosti z občanského života zahrnuje následující situace:","visibility":"public","folder":1389,"updatedAt":"2026-11-02T14:21:15.370Z","createdAt":"2026-11-02T14:21:15.370Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-obcanske-odpovednosti.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":690213,"width":1000,"height":630,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Samostatně nebo v balíčku","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti z občanského života lze pojistit i samostatně, ale nejvýhodnější je sjednat ho jako součást balíčku pojištění nemovitosti a domácnosti. Toto pojištění je ideální ochranou pro jednotlivce i rodiny.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění odpovědnosti z občanského života zahrnuje následující situace:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Osobní odpovědnost: kryje situace, kdy způsobíte třetí osobě tělesné zranění nebo poškození jejich majetku náhodným nebo neúmyslným jednáním.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za domácnost: pokrývá škody, které byly způsobeny ve vašem domově, jako je poškození majetku sousedů nebo návštěvníků, které se stalo v důsledku vašeho jednání.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za nemovitost: pokrývá škody, které byly způsobeny v okolí nemovitosti, jako například padající sníh ze střechy nebo kluzký chodník před budovou a podobné situace.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za zvířata: kryje škody způsobené vašimi domácími zvířaty, například pokud někoho pokousají nebo poškodí majetek jiných osob.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost za škody způsobené dítětem: pokrývá situace, kdy vaše dítě způsobí škody třetím osobám nebo jejich majetku.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Mohlo by se vám hodit","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"h3","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost z výkonu povolání","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jedná se o tzv. ZAM-ZAM pojištění, hovorově „pojistka na blbost v práci“. Protože každý zaměstnanec odpovídá zaměstnavateli za škody způsobené při výkonu povolání, a to až do výše 4,5násobku svého průměrného platu. Toto pojištění vás chrání pro případ neúmyslně způsobených škod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příklady nejčastějších škod","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození mobilního telefonu,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození služebního vozu,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození ochranných pomůcek nebo pracovních nástrojů,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"ztráta hotovosti, cenin či zboží.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"p