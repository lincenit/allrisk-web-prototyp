kých osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-21T21:18:03.674Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"pravni-ochrana","externalUrl":null,"updatedAt":"2026-11-23T22:53:42.652Z","createdAt":"2026-11-02T14:21:25.369Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"91d18c9661729fd531175195","photo":{"id":269,"filename":"pojisteni-domacnosti-hero.jpg","alt":"Pojištění domácnosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:24.885Z","createdAt":"2026-11-02T14:21:24.885Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-domacnosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":725806,"width":1250,"height":833,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ochrana vybavení domácnosti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištěním domácnosti si zajistíte ochranu vybavení vaší domácnosti - od nábytku, spotřebičů, elektroniky, oblečení, obuvi, věcí osobní potřeby až po věci uložené ve sklepě, garáži a podobně. Tento produkt je vhodný úplně pro každého, kdo už si nějakou domácnost pořídil, nejen pro rodinu, ale i jednotlivce.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co je možné zahrnout do ochrany domácnosti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Veškeré vnitřní vybavení domu nebo bytu, včetně věcí připevněných, a prostor k nim náležící.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"c0be756eb97d51dc67fd8340","photo":{"id":270,"filename":"pojisteni-domacnosti-photo.jpg","alt":"Pojištění domácnosti chrání před finančními následky škod vzniklých, například:","visibility":"public","folder":1434,"updatedAt":"2026-11-02T14:21:24.977Z","createdAt":"2026-11-02T14:21:24.977Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-domacnosti-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":918204,"width":1250,"height":870,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění domácnosti chrání před finančními následky škod vzniklých, například:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"požárem nebo výbuchem","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"dalšími živelnými pohromami: bouřky, vichřice, povodně, zemětřesení apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":