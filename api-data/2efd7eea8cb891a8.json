{"docs":[{"id":77,"_order":"b14","adminTitle":"Pojištění domácnosti","title":"Pojištění domácnosti","heroTitle":"Pojištění *domácnosti*","description":"Pojištění domácnosti je často klienty opomíjeno, jelikož se domnívají, že v pojištění nemovitosti již mají vše. Nicméně jsou to zcela rozdílné produkty.","heroPhoto":{"id":269,"filename":"pojisteni-domacnosti-hero.jpg","alt":"Pojištění domácnosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:24.885Z","createdAt":"2026-11-02T14:21:24.885Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-domacnosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":725806,"width":1250,"height":833,"focalX":50,"focalY":50},"heroVideo":null,"heroStills":[],"heroPoints":[{"id":"098fa1d64d1d752a045dc782","icon":"IconFlame","text":"Pokrývá škody vzniklé na vybavení vaší domácnosti"},{"id":"555debb4bba96b35f80c5369","icon":"IconLock","text":"Chrání nejen při živelné pohromě a řádění zlodějů"},{"id":"8d9ba6aaae03ca68a0223157","icon":"IconAdjustments","text":"Je dobrovolné, ale doporučujeme ho"}],"heroButtons":[{"id":"59b1525f1efd9b54b0de4218","icon":null,"iconAfter":"IconArrowUpRight","variant":"primary","url":"#kontakt","newTab":null,"label":"Chci tento produkt"},{"id":"f9c4ee6c0405ea6b65f53a0c","icon":null,"iconAfter":null,"variant":"outline","url":"/kontakty","newTab":null,"label":"Kontakty a pobočky"}],"menuTitle":"Domácnost","icon":"IconArmchair","summary":"Vybavení a věci uvnitř","cardPhoto":null,"similar":[{"id":78,"_order":"b15","adminTitle":"Pojištění nemovitosti","title":"Pojištění nemovitosti","heroTitle":"Pojištění *nemovitosti*","description":"„Můj dům, můj hrad“. Pojištění nemovitosti je zaměřeno na ochranu samotné budovy a souvisejících staveb na tomtéž pozemku. Tímto druhem pojištění lze pojistit budovu již ve fázi výstavby.","heroPhoto":{"id":155,"filename":"pojisteni-nemovitosti-hero.jpg","alt":"Pojištění nemovitosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.121Z","createdAt":"2026-11-02T14:21:15.121Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-nemovitosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":923955,"width":1250,"height":833,"focalX":50,"focalY":50},"menuTitle":"Nemovitost","icon":"IconHome","summary":"Dům, byt, chata i garáž","cardPhoto":null,"parent":{"id":6,"_order":"a5","adminTitle":"Pojištění majetku","title":"Pojištění majetku","heroTitle":"Pojištění *majetku*","description":"„Můj dům, můj hrad“. Pojištění nemovitosti je zaměřeno na ochranu samotné budovy a souvisejících staveb na tomtéž pozemku. Tímto druhem pojištění lze pojistit budovu již ve fázi výstavby.","heroPhoto":155,"menuTitle":"Majetek","icon":"IconHome","summary":"Nemovitost i domácnost","cardPhoto":null,"parent":1,"segments":["rodiny","podnikatele"],"slug":"majetek","externalUrl":null,"updatedAt":"2026-11-23T19:21:11.999Z","createdAt":"2026-11-02T14:21:25.275Z","_status":"published"},"segments":["rodiny"],"slug":"nemovitost","externalUrl":null,"updatedAt":"2026-11-23T19:14:50.667Z","createdAt":"2026-11-02T14:21:27.288Z","_status":"published"},{"id":9,"_order":"a8","adminTitle":"Pojištění občanské odpovědnosti","title":"Pojištění občanské odpovědnosti","heroTitle":"Pojištění *odpovědnosti z občanského života*","description":"Pojištění odpovědnosti z občanského života je typ pojištění chránící před finančními náklady, které způsobíte třetím osobám nebo jejich majetku. Toto pojištění může být velmi užitečné, protože některé škody a důsledky z nich mohou být nečekaně drahé.","heroPhoto":{"id":160,"filename":"odpovednost-hero.jpg","alt":"Pojištění občanské odpovědnosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.313Z","createdAt":"2026-11-02T14:21:15.313Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/odpovednost-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":422865,"width":2560,"height":1707,"focalX":50,"focalY":50},"menuTitle":"Odpovědnost","icon":