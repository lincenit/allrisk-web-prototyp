naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.415Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"zivot-a-uraz","externalUrl":null,"updatedAt":"2026-11-26T09:46:01.271Z","createdAt":"2026-11-02T14:21:25.558Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"3e7a838475080118405b2eb8","photo":{"id":193,"filename":"penzijni-sporeni-photo.jpg","alt":"Penzijní spoření","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.925Z","createdAt":"2026-11-02T14:21:16.925Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/penzijni-sporeni-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":860609,"width":1250,"height":833,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Doplněk ke státnímu důchodu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato forma spoření slouží k doplnění státního důchodu a umožňuje občanům navyšovat své příjmy po dosažení důchodového věku. Doplňkové penzijní spoření bylo zavedeno v roce 2013 a je organizováno pod záštitou Penzijního fondu České pojišťovny.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Starosti nechte na nás","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Váš čas je drahý, proto žijte. O vše ostatní se postaráme za vás. Kontaktujte naše odborníky, kteří pro vás připraví nabídku přímo na míru.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"77fbd2373c06c88bf24d94a6","photo":{"id":194,"filename":"penzijni-sporeni-hero.jpg","alt":"Výhody","visibility":"public","folder":1400,"updatedAt":"2026-11-02T14:21:16.993Z","createdAt":"2026-11-02T14:21:16.993Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/penzijni-sporeni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":775832,"width":1250,"height":833,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výhody","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Státní příspěvek až 2 760 Kč ročně,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Úspora na daních až 3 600 Kč ročně,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Žádné vstupní poplatky, sjednání je zdarma,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přispívat vám může i zaměstnavatel,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Spořit můžete i dětem.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Fungování doplňkových penzijních spoření","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Osobní volba fondu:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" každý občan, který začne pracovat, je automaticky zařazen do systému doplňkového penzijního spoření. Má však možnost si vybrat konkrétní penzijní fond, do kterého budou směřovány jeho příspěvky. Existuje několik penzijních fondů, které spravují peníze účastníků a investují je s cílem dosáhnout co nejlepšího zhodnocení.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příspěvky:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" každý účastník DPS povinně odvádí určitý procentní podíl ze své hrubé mzdy (osobní příspěvek). K tomu se přidává ještě státní příspěvek, který je závislý na výši osobního příspěvku. Čím více účastníků spoří, tím větší podíl státního příspěvku obdrží. Státní příspěvek je limitován určitou částkou.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Investování:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" penzijní fondy investují shromážděné finanční prostředky do různých aktiv, jako jsou akcie, dluhopisy, nemovitosti atd. Cílem je dosáhnout co nejlepšího zhodnocení a zvýšit hodnotu spoření účastníků.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"114ebd90aa3fa47e9e813449","photo":{"id":195,"filename":"penzijni-sporeni-produkt2.jpg","alt":"Důchodový věk:","visibility":"public","folder":1400,"updatedAt":"2026-11-02T14:21:17.040Z","createdAt":"2026-11-02T14:21:17.040Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/penzijni-sporeni-produkt2.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":999104,"width":1250,"height":834,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Důchodový věk:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" po dosažení důchodového věku má účastník možnost si nechat vyplácet peníze, které spořil. Může si vybrat, zda chce peníze jako jednorázové vyplacení, nebo chce pravidelný měsíční příjem, který mu bude vyplácen až do konce života.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Daňové výhody:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" doplňkové penzijní spoření je spojeno s daňovými výhodami. Příspěvky do penzijního fondu mohou být odečteny z hrubé mzdy, což znamená, že se na ně neplatí daně. Daně budou placeny až při vyplácení penze.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přenosnost:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" pokud se účastník rozhodne změnit penzijní fond, může to udělat bez poplatků a ztráty dosavadních příspěvků.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Omezení výběru:","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" doplňkové penzijní spoření má určitá omezení, například není možné vybrat si peníze před dosažením důchodového věku, pokud účastník není postižen závažnou nemocí nebo nezemře.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Je důležité si přečíst informace o různých penzijních fondech, jejich poplatcích, investičních strategiích a dalších podmínkách, abyste mohli rozhodnout, který fond je pro vás vhodný.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příklady z praxe","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vstupní věk klienta 45 let s horizontem 20 let vám 100 Kč vydělá 116 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vstupní věk klienta 25 let s horizontem 40 let vám 100 Kč vydělá 319 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vstupní věk klienta 5 let s horizontem 60 let vám 100 Kč vydělá 769 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příklady počítají s průměrným výnosem 5 %","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"4391e052699fd4270cb8fde1","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"3fd1bac271f4b45ef9379e82","lead":null,"label":"Podobné produkty","title":"Doplňkovým penzijním spořením *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"064ec416942dfaabb7518152","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","person":{},"blockName":null,"blockType":"contact","attachments":false},"format":"","version":2}],"direction":"ltr"}},"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","menuTitle":null,"icon":"IconCoins","summary":"Úvěry, investice a účty srovnané napříč trhem.","cardPhoto":null,"heroTitle":null,"description":"Rodinné finance zahrnují veškeré finanční aspekty našeho života. Jejich správa není vždy jednoduchá, a proto máme tým zkušených specialistů, který je připravený vyhodnotit vaši situaci a navrhnout nejlepší kombinaci správy a investic vašich financí.","heroPho