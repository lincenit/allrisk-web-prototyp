dy i Allrisk.","heroPhoto":{"id":184,"filename":"dip-hero.jpg","alt":"Dlouhodobé investiční produkty","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:16.307Z","createdAt":"2026-11-02T14:21:16.307Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/dip-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":954196,"width":1250,"height":833,"focalX":50,"focalY":50},"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","menuTitle":null,"icon":"IconCoins","summary":"Úvěry, investice a účty srovnané napříč trhem.","cardPhoto":null,"heroTitle":null,"description":"Rodinné finance zahrnují veškeré finanční aspekty našeho života. Jejich správa není vždy jednoduchá, a proto máme tým zkušených specialistů, který je připravený vyhodnotit vaši situaci a navrhnout nejlepší kombinaci správy a investic vašich financí.","heroPhoto":152,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"finance","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.497Z","createdAt":"2026-11-02T14:21:25.213Z","_status":"published"},"segments":["rodiny"],"slug":"dip","externalUrl":null,"updatedAt":"2026-11-26T09:46:01.508Z","createdAt":"2026-11-02T14:21:25.686Z","_status":"published"},{"id":38,"_order":"b01","adminTitle":"Stavební spoření","title":"Stavební spoření","menuTitle":null,"icon":"IconBuildingBank","summary":"Úvěr ze stavebního spoření","cardPhoto":null,"heroTitle":"Stavební *spoření*","description":"Stavební spoření kombinuje možnost tvořit rezervu i získat účelový úvěr na bydlení.","heroPhoto":{"id":200,"filename":"stavebni-sporeni-photo-2.jpg","alt":"Stavební spoření","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:17.346Z","createdAt":"2026-11-02T14:21:17.346Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/stavebni-sporeni-photo-2.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":817748,"width":1300,"height":868,"focalX":50,"focalY":50},"parent":{"id":3,"_order":"a2","adminTitle":"Finance","titl