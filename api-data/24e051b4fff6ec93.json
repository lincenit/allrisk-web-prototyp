ght":1000,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Když něco ve vašem životě nejde podle plánu a ocitnete se ve sporu nebo konfliktu, může to být docela stresující a finančně náročné. Tady právě vstupuje do hry pojištění právní ochrany.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Máte-li toto pojištění, můžete se cítit klidnější, protože kdybyste potřebovali právní pomoc, pojišťovna vám může pomoci. Když máte problém a potřebujete právního zástupce (jako by to byl váš osobní superhrdina v právním světě), pojišťovna může platit za advokátní poplatky, soudní náklady a další věci, které by vás mohly stát spoustu peněz.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Zajímavý je cenový poměr této služby. Například u produktu RODINNÝ PRÁVNÍK, kde roční cena odpovídá hodnotě dvou hodin advokátního poradenství, vám v případě potřeby poskytne služby až v hodnotě 500 000 Kč. Pokud byste chtěli stejnou částku naspořit tím, že nebudete mít pojištění právní ochrany, bude vám to trvat 150 let.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Mohlo by se vám hodit","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"h3","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost z výkonu povolání","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jedná se o tzv. ZAM-ZAM pojištění, hovorově „pojistka na blbost v práci“. Protože každý zaměstnanec odpovídá zaměstnavateli za škody způsobené při výkonu povolání, a to až do výše 4,5 násobku svého průměrného platu. Toto pojištění vás chrání pro případ neúmyslně způsobených škod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Příklady nejčastějších škod","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození mobilního telefonu,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození služebního vozu,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"poškození ochranných pomůcek nebo pracovních nástrojů,","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"ztráta hotovosti, cenin či zboží.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"block","fields":{"id":"477191ba4fbdb3ebe1c204e1","lead":null,