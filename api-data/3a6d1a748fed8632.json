tle":"Reality","menuTitle":null,"icon":"IconBuildingEstate","summary":"Prodej, nákup i nájem - papírování necháte na nás.","cardPhoto":null,"heroTitle":null,"description":"Jsme profesionálové v oblasti realitního zprostředkování. Poskytujeme nadstandardní servis při prodejích i pronájmech domů, bytů, chat, pozemků a jednou z našich specializací je i prodej a pronájem komerčních nemovitostí. Není nám cizí ani svět aukcí.","heroPhoto":151,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.460Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny"],"slug":"prodej-nemovitosti","externalUrl":null,"updatedAt":"2026-11-26T09:46:03.839Z","createdAt":"2026-11-02T14:21:26.953Z","_status":"published"},{"id":70,"_order":"b0x","adminTitle":"Allrisk nájem bez rizika","title":"Allrisk nájem bez rizika","menuTitle":"Nájem bez rizika","icon":"IconKey","summary":"Nájem na účtu každý měsíc","cardPhoto":null,"heroTitle":"Allrisk nájem *bez rizika*","description":"Není to jen služba o papírování a fakturách. Je to o důvěře, technické jistotě a rychlé reakci. A přesně to nabízíme. Přenechejte správu své nemovitosti profesionálům, kteří rozumí technickým detailům i lidskému přístupu. Jsme spolehlivý partner pro vlastníky bytů, SVJ, bytová družstva i investory.","heroPhoto":{"id":254,"filename":"risk-free-rental-hero.jpg","alt":"Allrisk nájem bez rizika","visibility":"public","folder":1426,"updatedAt":"2026-11-02T14:21:21.845Z","createdAt":"2026-11-02T14:21:21.845Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/risk-free-rental-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":398127,"width":1920,"height":1280,"focalX":50,"focalY":50},"parent":{"id":2,"_order":"a1","adminTitle":"Reality","title":"Reality","menuTitle":null,"icon":"IconBuildingEstate","summary":"Prodej, nákup i nájem - papírování necháte na nás.","cardPhoto":null,"heroTitle":null,"description":"Jsme profesionálové v oblasti realitního zprostředkování. Poskytujeme nadstandardní servis při prodejích i pronájmech domů, bytů, chat, pozemků a jednou z našich specializací je i prodej a pronájem komerčních nemovitostí. Není nám cizí ani svět aukcí.","heroPhoto":151,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.460Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny","podnikatele","mesta"],"slug":"najem-bez-rizika","externalUrl":null,"updatedAt":"2026-11-26T09:46:03.988Z","createdAt":"2026-11-02T14:21:27.039Z","_status":"published"},{"id":73,"_order":"b10","adminTitle":"Odhad tržní ceny nemovitosti","title":"Odhad tržní ceny nemovitosti","menuTitle":null,"icon":"IconChartBar","summary":"Reálná cena zdarma","cardPhoto":null,"heroTitle":"Odhad *tržní ceny* nemovitosti","description":"Zjistěte reálnou tržní cenu vaší nemovitosti zdarma - report z aktuálních dat katastru a inzerce.","heroPhoto":{"id":261,"filename":"market-valuation-hero.jpg","alt":"Odhad tržní ceny nemovitosti","visibility":"public","folder":1429,"updatedAt":"2026-11-02T14:21:22.967Z","createdAt":"2026-11-02T14:21:22.966Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/market-valuation-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":248681,"width":1920,"height":1080,"focalX":50,"focalY":50},"parent":{"id":2,"_order":"a1","adminTitle":"Reality","title":"Reality","menuTitle":null,"icon":"IconBuildingEstate","summary":"Prodej, nákup i nájem - papírování necháte na nás.","cardPhoto":null,"heroTitle":null,"description":"Jsme profesionálové v oblasti realitního zprostředkování. Poskytujeme nadstandardní servis při prodejích i pronájmech domů, bytů, chat, pozemků a jednou z našich specializací je i prodej a pronájem komerčních nemovitostí. Není nám cizí ani svět aukcí.","heroPhoto":151,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.460Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny"],"slug":"odhad-trzni-ceny","externalUrl":null,"updatedAt":"2026-11-26T09:46:04.133Z","createdAt":"2026-11-02T14:21:27.131Z","_status":"published"},{"id":6,"_order":"a5","adminTitle":"Pojištění majetku","title":"Pojištění majetku","menuTitle":"Majetek","icon":"IconHome","summary":"Nemovitost i domácnost","cardPhoto":null,"heroTitle":"Pojištění *majetku*","description":"„Můj dům, můj hrad“. Pojištění domácnosti je často klienty opomíjeno, jelikož se domnívají, že v pojištění nemovitosti již mají vše. Nicméně jsou to zcela rozdílné produkty.","heroPhoto":{"id":155,"filename":"pojisteni-nemovitosti-hero.jpg","alt":"Pojištění nemovitosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.121Z","createdAt":"2026-11-02T14:21:15.121Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-nemovitosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":923955,"width":1250,"height":833,"focalX":50,"focalY":50},"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.415Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["rodiny"],"slug":"majetek","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.627Z","createdAt":"2026-11-02T14:21:25.275Z","_status":"published"},{"id":79,"_order":"a5V","adminTitle":"Pojištění nemovitosti","title":"Pojištění nemovitosti","menuTitle":"Nemovitost","icon":"IconHome","summary":"Budovy, provozovny i sklady","cardPhoto":null,"heroTitle":"Pojištění *nemovitosti*","description":"Náš produkt pojištění nemovitosti je navržený tak, aby poskytoval komplexní ochranu vašim podnikatelským aktivům. Pokrývá nejen samotné budovy a vybavení, ale i rizika spojená se živelnými událostmi, krádežemi, vandalizmem a dalšími nepředvídatelnými situacemi. S naším pojištěním nemovitosti můžete podnikat s klidem, vědomi si toho, že vaše investice jsou řádně chráněny.","heroPhoto":{"id":272,"filename":"pojisteni-nemovitosti-hero-2.jpg","alt":"Pojištění nemovitosti","visibility":"public","folder":1435,"updatedAt":"2026-11-02T14:21:25.091Z","createdAt":"2026-11-02T14:21:25.091Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-nemovitosti-hero-2.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":1126557,"width":1200,"height":675,"focalX":50,"focalY":50},"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.415Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["podnikatele"],"slug":"nemovitost","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.680Z","createdAt":"2026-11-02T14:21:27.316Z","_status":"published"},{"id":64,"_order":"b0r","adminTitle":"Podnikatelské úvěry","title":"Podnikatelské úvěry","menuTitle":null,"icon":"IconCoin","summary":"Financování rozvoje firmy","cardPhoto":null,"heroTitle":"*Podnikatelské* úvěry","description":"Hledáte finanční podporu pro rozvoj vašeho podnikání? Naše nabídka podnikatelských úvěrů je připravena vám pomoci dosáhnout vašich podnikatelských cílů.","heroPhoto":{"id":242,"filename":"podnikatelske-uvery-hero.jpg","alt":"Podnikatelské úvěry","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:19.957Z","createdAt":"2026-11-02T14:21:19.957Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/podnikatelske-uvery-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":856027,"width":1500,"height":1001,"focalX":50,"focalY":50},"parent":{"id":3,"_order":"a2","adminTitle":"Finance","title":"Finance","menuTitle":null,"icon":"IconCoins","summary":"Úvěry, investice a účty srovnané napříč trhem.","cardPhoto":null,"heroTitle":null,"description":"Rodinné finance zahrnují veškeré finanční aspekty našeho života. Jejich správa není vždy jednoduchá, a proto máme tým zkušených specialistů, který je připravený vyhodnotit vaši situaci a navrhnout nejlepší kombinaci správy a investic vašich financí.","heroPhoto":152,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"finance","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.497Z","createdAt":"2026-11-02T14:21:25.213Z","_status":"published"},"segments":["podnikatele"],"slug":"podnikatelske-uvery","externalUrl":null,"updatedAt":"2026-11-26T09:46:03.688Z","createdAt":"2026-11-02T14:21:26.866Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"b2e1db6e0f2fd50f9897d15b","photo":{"id":268,"filename":"commercial-property.avif","alt":"Komerční nemovitosti","visibility":"public","folder":1432,"updatedAt":"2026-11-02T14:21:24.826Z","createdAt":"2026-11-02T14:21:24.826Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/commercial-property.avif","thumbnailURL":null,"mimeType":"image/avif","filesize":138908,"width":1536,"height":1024,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Specialisté na komerční nemovitosti od roku 2005","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nemovitosti nenabízíme, ale prodáváme.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jednou z našich specializací je zprostředkování prodeje a pronájmu komerčních nemovitostí. Máme za sebou stovky realizovaných komerčních prodejů a pronájmů od roku 2005. Víme, co dělat, abychom pro vaši nemovitost našli odpovídajícího zájemce.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co umíme prodat nebo pronajmout:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kanceláře","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Sklady","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výrobní prostory","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Obchodní prostory","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Ubytovací objekty","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Restaurace","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":7,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Činžovní domy","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":8,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Zemědělské objekty","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":9,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pozemky pro komerční výstavbu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":10,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Převod obchodních podílů","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"9f3d39f37d3d4070eb1f9266","size":"small","title":"7 kroků pro úspěšnou realizaci:","blockName":"","blockType":"heading"},"format":"","version":2},{"type":"block","fields":{"id":"042e693d79ef9e3a0ed8b17d","items":[{"id":"9b6dd83d1e0a454ba88bb75f","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"1. Neprodávejte pod cenou","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vaši nemovitost oceníme nezávisle a ZDARMA. ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"/rodiny-a-jednotlivci/reality/odhad-trzni-ceny","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"Více informací zde","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"2. Navrhneme prodejní strategii","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Naši zkušení realitní makléři vytvoří strategii s ohledem na vaši situaci, typ nemovitosti, lokalitu se zacílením na vhodnou klientelu. Zvlášť u komerčních nemovitostí je prodejní strategie klíčová.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"3. Víme, co prodává","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Profesionální fotografie, videoprohlídky s grafickými prvky, pohledy z dronu, virtuální prohlídky a 3D scany nemovitostí ve spolupráci s výhradním zastoupením americké společnosti Matterport.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"4. Prodáváme aktivně","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kompletní inzerce na realitních webech je jen jedna ze součástí prodejní strategie. Na vaši nemovitost čekají klienti z naší databáze poptávajících. Zakázku nabízíme klientům z prohlídek na obdobných nemovitostech. Aktivně pracujeme s databází firem v oboru, pro které je nemovitost vhodná. Nečekáme. Kupujícího umíme najít.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"3157a01f1496c42039d220ae","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"5. Nic netajíme","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pravidelně vám předáváme přehled o počtech zhlédnutí zakázky, topování a dotazech klientů. Po prohlídce nemovitosti vždy obdržíte zpětnou vazbu klienta, ať už projeví zájem či nikoliv.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"6. Kompletní sada smluvní dokumentace","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Vypracovaná advokátní kanceláří. U nás máte jistotu, že obchodní případ proběhne podle platných právních a daňových předpisů. Pro zabezpečení kupní ceny využíváme notářské či advokátní úschovy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"7. Prodejem to nekončí","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Realizací zakázky pro nás vztah s klientem nekončí. Zajistíme pro vás i další související služby spojené s prodejem nemovitosti. Například garantovanou úsporu na energiích nebo bonus 300 Kč na nezávaznou kontrolu finančních a pojistných produktů.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"perRow":"2","blockName":"","blockType":"columns"},"format":"","version":2},{"type":"block","fields":{"id":"f24b5603d3fa7aada526f142","lead":null,"label":"Podobné produkty","title":"Tím to *nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"9985b78c2d188a42656036e6","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zdarma.","label":"Kontakt","title":"Ozvěte se *nám*","topic":null,"anchor":"kontakt","person":{},"blockName":null,"blockType":"contact","attachments":false},"format":"","version":2}],"direction":"ltr"}},"parent":{"id":2,"_order":"a1","adminTitle":"Reality","title":"Reality","menuTitle":null,"icon":"IconBuildingEstate","summary":"Prodej, nákup i nájem - papírování necháte na nás.","cardPhoto":null,"heroTitle":null,"description":"Jsme profesionálové v oblasti realitního zprostředkování. Poskytujeme nadstandardní servis při prodejích i pronájmech domů, bytů, chat, pozemků a jednou z našich specializací je i prodej a pronájem komerčních nemovitostí. Není nám cizí ani svět aukcí.","heroPhoto":{"id":151,"filename":"meridiem-slider.jpg","alt":"Reality","visibility":"public","folder":1384,"updatedAt":"2026-11-02T14:21:14.910Z","createdAt":"2026-11-02T14:21:14.910Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/meridiem-slider.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":931961,"width":1077,"height":897,"focalX":50,"focalY":50},"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"reality","externalUrl":null,"updatedAt":"2026-11-26T09:46:00.460Z","createdAt":"2026-11-02T14:21:25.191Z","_status":"published"},"segments":["rodiny","podnikatele"],"slug":"komercni-nemovitosti","externalUrl":null,"updatedAt":"2026-11-26T09:46:04.293Z","createdAt":"2026-11-02T14:21:27.215Z","_status":"published"}],"hasNextPage":false,"hasPrevPage":false,"limit":20,"nextPage":null,"page":1,"pagingCounter":1,"prevPage":null,"totalDocs":1,"totalPages":1}