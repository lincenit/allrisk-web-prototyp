ype":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Komplexní krytí","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nabízíme komplexní krytí, které zahrnuje jak majetkovou ochranu pro vaše budovy a vybavení, tak i odpovědnostní krytí pro případnou škodu způsobenou třetím stranám.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Chráníme zájmy nájemníků, majitelů a společenství vlastníků","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V případě, že dojde k pojistné události a byt se stane neobyvatelným, zajišťujeme pomoc s náklady na náhradní ubytování. Pojištění odpovědnosti pak chrání přímo majitele nemovitosti, zástupce společenství vlastníků nebo bytového družstva.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"11f98768379f7fb906f6a0e5","photo":{"id":225,"filename":"bytove-domy-podnikatele-hero.jpg","alt":"Co můžete pojistit v rámci pojištění bytových domů?","visibility":"public","folder":1412,"updatedAt":"2026-11-02T14:21:18.937Z","createdAt":"2026-11-02T14:21:18.937Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/bytove-domy-podnikatele-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":528529,"width":1000,"height":667,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co můžete pojistit v rámci pojištění bytových domů?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Bytový dům a jeho příslušenství - garáže, oplocení, trafostanice, kotelny, dětská hřiště apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Veškeré komponenty bytového domu a příslušenství.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Elektromotory, anténní systémy (STA), přístupové a kamerové systémy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výtahy, technologie kotelen, tepelná čerpadla, rekuperace.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Movité věci - zařízení společných prostor, stroje a zařízení pro údržbu bytového domu a jeho okolí (např. sekačka na trávu), stavební materiál, hasicí přístroje a hasicí vybavení apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V ceně pojištění bytového domu je také zahrnuto","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type"