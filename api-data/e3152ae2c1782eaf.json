stva.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"dded7bb9561dba2ad48a65a7","photo":{"id":227,"filename":"pojisteni-bytovych-domu.jpg","alt":"Co můžete pojistit v rámci pojištění bytových domů?","visibility":"public","folder":1412,"updatedAt":"2026-11-02T14:21:19.057Z","createdAt":"2026-11-02T14:21:19.057Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-bytovych-domu.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":1059363,"width":1000,"height":667,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co můžete pojistit v rámci pojištění bytových domů?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Bytový dům a jeho příslušenství - garáže, oplocení, trafostanice, kotelny, dětská hřiště apod.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Veškeré komponenty bytového domu a příslušenství.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Elektromotory, anténní systémy (STA), přístupové a kamerové systémy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výtahy, technolo