í osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.283Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["podnikatele"],"slug":"kyberneticka-rizika","externalUrl":null,"updatedAt":"2026-11-26T12:04:47.238Z","createdAt":"2026-11-02T14:21:26.660Z","_status":"published"},{"id":53,"_order":"b0g","adminTitle":"D&O pojištění","title":"D&O pojištění","menuTitle":null,"icon":"IconBriefcase","summary":"Odpovědnost vedení firmy","cardPhoto":null,"heroTitle":"*D&O* Pojištění odpovědnosti členů orgánů společnosti","description":"Pojištění odpovědnosti členů orgánů společnosti poskytuje ochranu pro vedoucí pracovníky a členy správních orgánů proti riziku osobní a majetkové ztráty vyplývající z výkonu jejich funkcí.","heroPhoto":{"id":219,"filename":"do-pojisteni-hero.jpg","alt":"D&O pojištění","visibility":"public","folder":1410,"updatedAt":"2026-11-02T14:21:18.612Z","createdAt":"2026-11-02T14:21:18.612Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/do-pojisteni-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":876278,"width":1250,"height":833,"focalX":50,"focalY":50},"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištění osob, podnikatelů i právnických osob. Jako naši klienti máte možnost v rámci Allrisk pojištění získat různé slevy a další výhody.","heroPhoto":150,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:44.283Z","createdAt":"2026-11-02T14:21:25.159Z","_status":"published"},"segments":["podnikatele"],"slug":"d-o-pojisteni","externalUrl":null,"updatedAt":"2026-11-26T12:04:47.034Z","createdAt":"2026-11-02T14:21:26.547Z","_status":"published"}],"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"block","fields":{"id":"e7a9f84e2aab365118863da0","photo":{"id":230,"filename":"prumyslova-nebezpeci-hero.jpg","alt":"Průmyslová nebezpečí","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:19.225Z","createdAt":"2026-11-02T14:21:19.225Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prumyslova-nebezpeci-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":824513,"width":1200,"height":800,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Budovy, movité věci a zásoby","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Rádi bychom vám představili naše pojištění průmyslových nebezpečí, které je navržené tak, aby krylo náklady na opravu nebo nahrazení poškozených nebo ztracených budov, movitých věcí a zásob.","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"V našem pojištění jsme se zaměřili na tři hlavní oblasti:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kromě základních krytí máme také širokou škálu volitelných připojištění, která vám umožní přizpůsobit pojištění vašim potřebám a specifickým rizikům, se kterými se ve vašem podnikání můžete setkat.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pojištění průmyslových nebezpečí je navrženo tak, aby vám poskytlo klid a jistotu, že váš majetek a odpovědnost jsou v bezpečí. Pokud máte zájem, rádi vám poskytneme další informace a poradíme vám s vhodným pojistným řešením pro váš podnik. Buďte v bezpečí s naším pojištěním!","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"bca65473a619d6d2f1713ad8","photo":{"id":231,"filename":"prumyslova-nebezpeci-photo.jpg","alt":"Majetek","visibility":"public","folder":1414,"updatedAt":"2026-11-02T14:21:19.303Z","createdAt":"2026-11-02T14:21:19.303Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/prumyslova-nebezpeci-photo.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":844707,"width":800,"height":530,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Majetek","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato část pojištění kryje náklady na opravu nebo nahrazení budov, movitých věcí a zásob v důsledku různých pojistných událostí, jako jsou požáry, přímé údery bleskem, povodně, krupobití a další.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Přerušení provozu","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokud dojde k věcné škodě na vašem majetku, můžeme pokrýt finanční ztráty vzniklé v důsledku ztráty zisku, stálých nákladů a dalších souvisejících nákladů.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Odpovědnost","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Tato část pojištění se týká povinnosti nahradit škodu nebo újmu, kterou můžete způsobit třetí osobě v důsledku vaší činnosti nebo právního vztahu. Pokrývá škody na majetku, újmy na zdraví, finanční škody a další.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"left"},"format":"","version":2},{"type":"block","fields":{"id":"3ef6ef6be489da7fc7bc7898","lead":null,"label":"Modelové situace","title":"Jak to dopadlo u *našich klientů*","anchor":null,"blockName":null,"blockType":"situations"},"format":"","version":2},{"type":"block","fields":{"id":"a61d6b83171a4aec8013c653","lead":null,"label":"Podobné produkty","title":"Pojištěním průmyslových nebezpečí *to nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"7944bb7385148bd7842f9808","anchor":"kontakt","blockName":null,"blockType":"contact"},"format":"","version":2}],"direction":"ltr"}},"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":nu