","fields":{"id":"8c4e2a2e59db5f374776ebe5","photo":{"id":258,"filename":"home-insurance.avif","alt":"Zpětný leasing nemovitosti","visibility":"public","folder":1427,"updatedAt":"2026-11-02T14:21:22.789Z","createdAt":"2026-11-02T14:21:22.789Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/home-insurance.avif","thumbnailURL":null,"mimeType":"image/avif","filesize":74067,"width":1536,"height":1024,"focalX":50,"focalY":50},"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Řešení dluhů bez ztráty domova","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Hrozí vám dražba a nevíte, co s tím? Dostali jste se do dluhové pasti a trápí vás exekuce? Nechcete přijít o svůj dům a potřebujete pomoc s oddlužením?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Trápíte se s některým z těchto problémů? Pomůžeme vám ho vyřešit. Zpětný leasing je určený pro klienty, kteří se chtějí vyrovnat se svými dluhovými problémy a nadále užívat svoji nemovitost.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Hlavní parametry zpětného leasingu:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Zachráníme vám zadluženou nemovitost.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Převezmeme jednání se všemi věřiteli a tím ponížíme závazky.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Následně uhradíme vaše dluhy a exekuce.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nemovitosti nakupujeme za 70 % tržní hodnoty.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Majitel získá exkluzivní nájemní smlouvu na dobu až 5 let.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Výše nájmu činí 1 % z vyplacené kupní ceny.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":7,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Původní majitel má předkupní právo koupit nemovitost kdykoli zpět do 5 let (i na hypotéku).","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":8,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Kupní cena bude navýšena pouze o 5 % ročně.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"}],"direction":"ltr"}},"photoFit":"cover","blockName":"","blockType":"section","photoSide":"right"},"format":"","version":2},{"type":"block","fields":{"id":"f58bbddaaffb70997fe2aaee","size":"small","title":"Příklad zpětného leasingu z praxe:","blockName":"","blockType":"heading"},"format":"","version":2},{"type":"block","fields":{"id":"613805387c32d22d7fd60224","items":[{"id":"b0e4c204a0ccabfa9a40c216","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Mladý pár s dětmi se rozhodl pro koupi malého domu za cenu 2 000 000 Kč. Část peněz měli naspořenou a na zbytek si vzali hypotéku. Po nějaké době kvůli finančním problémům nemohli řádně hradit měsíční splátky hypotečního úvěru, a tak si vyřídili několik menších půjček, které však přerostly v exekuce. Mladému páru tak hrozilo, že o své bydlení přijde a zůstanou mu pouze dluhy.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klienti využili náš produkt Zpětný leasing, což jim umožnilo uhradit všechny své závazky a zůstat bydlet ve svém domě. Jak vše probíhalo?","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Dům byl koupen za 70 % jeho tržní hodnoty, tedy za cenu: 1 400 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Z kupní ceny byla uhrazena částka věřitelům: 1 000 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientům byla vyplacena částka: 400 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klienti následně podepsali nájemní smlouvu na dobu 5 let s výší nájmu 1 % z vyplacené kupní ceny. Existoval zde vysoký předpoklad, že v době trvání nájemní smlouvy budou vymazány jejich záznamy v bankovních registrech. V záložní variantě se počítalo s tím, že by o hypoteční úvěr na zpětnou koupi domu mohl zažádat bratr klienta.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}},{"id":"f88c8175d6c3acc83a36f0e5","content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"S vyplacenou částkou ve výši 400 000 Kč mohou klienti naložit takto:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ol","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Použít ji pro svoji potřebu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Složit ji jako část budoucí kupní ceny, tím si poníží měsíční splátku nájmu z předpokládaných 14 000 Kč měsíčně na částku 10 000 Kč měsíčně; zároveň jim bude částka 400 000 Kč úročena 1 % ročně.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"number","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokud klienti zvolí variantu 2), zpětná koupě proběhne za těchto podmínek:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Stanovená budoucí kupní cena (navýšení 5 % ročně x 5 let): 1 750 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Složená část budoucí kupní ceny: - 400 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Úroky za dobu 5 let z částky 400 000 Kč: - 20 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Požadovaná výše hypotéky: 1 330 000 Kč","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Klientům tak na zpětnou koupi postačí vyřízení hypotéky ve výši 1 330 000 Kč, což činí 66,5 % z reálné tržní ceny domu (předpokládaný odhad znalcem 2 000 000 Kč).","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pro více informací nás neváhejte kontaktovat:","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}}}],"perRow":"2","blockName":"","blockType":"columns"},"format":"","version":2},{"type":"block","fields":{"id":"75dac6283465701b2fb8388d","lead":null,"label":"Podobné produkty","title":"Tím to *nekončí*","anchor":null,"blockName":null,"blockType":"similar"},"format":"","version":2},{"type":"block","fields":{"id":"cd2aff40dd5b90f6a45678e0","lead":"Nechte nám kontakt a ozve se vám osobní poradce Allrisk - nezávazně, srozumitelně a zda