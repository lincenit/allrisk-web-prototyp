{"docs":[{"id":6,"adminTitle":"Aktivujte si ještě více výhod. Jedinečná Allrisk nálepka","title":"Aktivujte si ještě více výhod. Jedinečná *Allrisk nálepka*","perex":"V Allrisku slovo nálepka znamená jedinečnost. Za co jinde platíte navíc, máte s naším jedinečným autopojištěním Allrisk vždy zdarma.","cover":{"id":304,"filename":"allrisk-nalepka-2025-cover.png","alt":"Allrisk nálepka","visibility":"public","folder":1453,"updatedAt":"2026-11-02T14:21:29.756Z","createdAt":"2026-11-02T14:21:29.756Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/allrisk-nalepka-2025-cover.png","thumbnailURL":null,"mimeType":"image/png","filesize":1186031,"width":1000,"height":838,"focalX":50,"focalY":50},"rubric":"pojisteni","publishedAt":"2024-10-18T11:41:43.000Z","readMinutes":2,"author":null,"product":null,"content":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Co nálepka umí","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nálepka není jen slovo. U nás v Allrisku znamená jedinečnost. Za co jinde musíte platit, s naším jedinečným autopojištěním máte vždy zdarma.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"ul","type":"list","start":1,"format":"","indent":0,"version":1,"children":[{"type":"listitem","value":1,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"náhradní vozidlo","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ v případě nehody až na 20 dní ZDARMA","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":2,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění zničení disků","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ v důsledku špatné vozovky, BEZ spoluúčasti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":3,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění poškození kabeláže vozidla zvířetem","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ vč. rizika poškození měkkých gumových či plastových hadiček, BEZ spoluúčasti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":4,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění střetu se zvěří","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ při srážce je hrazena škoda na vašem vozidle, BEZ spoluúčasti","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":5,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění pneumatik","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ proti defektu nebo proražení","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":6,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění asistencí přívěsu","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" do 750 kg","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":7,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"živel a vandalismus","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ asistenční služby již v základním programu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":8,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"odtah a vyproštění","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" v rámci ČR ‒ po nehodě, BEZ limitu","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"listitem","value":9,"format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"pojištění právní ochrany","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" ‒ základní balíček ZDARMA","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"}],"listType":"bullet","direction":"ltr"},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Postup pro aktivaci nálepky Allrisk","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Začít čerpat všech výhod naší Allrisk nálepky je velmi jednoduché.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nalepte Allrisk nálepku na zadní část vašeho vozidla. Vylepenou nálepku nám vyfoťte i s registrační značkou (SPZ). Fotku zašlete na e-mail: ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"mailto:nalepka@allrisk.cz","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"nalepka@allrisk.cz","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr"},{"mode":"normal","text":" a do předmětu e-mailu uveďte číslo své SPZ (tzn. písmena a číslice, např. 7B36310).","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Do 5 pracovních dnů vám ZDARMA zaktivujeme tento nový asistenční program, potvrzení o aktivaci vám přijde formou SMS. Hotovo. Od této chvíle jste členem světa výhod Allrisk nálepky.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"tag":"h2","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Důležité informace","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Nálepka musí být na vašem vozidle nalepena trvale. Pokud dojde k nehodě či poruše a pracovník odtahu či dalších přivolaných asistenčních služeb na vašem voze Allrisk nálepku nenajde, zvýšený limit čerpání nebude uznán a vy budete muset veškeré náklady na asistence uhradit ze svého rozpočtu.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Pokud ještě nemáte svou nálepku Allrisk, můžete si ji vyzvednout ","type":"text","style":"","detail":0,"format":0,"version":1},{"mode":"normal","text":"na našich pobočkách, u správce vaší smlouvy nebo nám napište","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" na adresu ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"mailto:nalepka@allrisk.cz","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"nalepka@allrisk.cz","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr"},{"mode":"normal","text":" a my vám ji zdarma zašleme.","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Při ","type":"text","style":"","detail":0,"format":0,"version":1},{"mode":"normal","text":"změně telefonního čísla","type":"text","style":"","detail":0,"format":1,"version":1},{"mode":"normal","text":" nás neprodleně informujte na adrese ","type":"text","style":"","detail":0,"format":0,"version":1},{"type":"link","fields":{"url":"mailto:obchod@allrisk.cz","newTab":false,"linkType":"custom"},"format":"","indent":0,"version":3,"children":[{"mode":"normal","text":"obchod@allrisk.cz","type":"text","style":"","detail":0,"format":1,"version":1}],"direction":"ltr"},{"mode":"normal","text":".","type":"text","style":"","detail":0,"format":0,"version":1}],"direction":"ltr","textStyle":"","textFormat":0}],"direction":"ltr"}},"slug":"allrisk-nalepka-2025","updatedAt":"2026-11-02T14:21:32.076Z","createdAt":"2026-11-02T14:21:32.076Z","_status":"published"}],"hasNextPage":false,"hasPrevPage":false,"limit":1,"nextPage":null,"page":1,"pagingCounter":1,"prevPage":null,"totalDocs":1,"totalPages":1}