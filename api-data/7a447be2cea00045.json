":"a2","adminTitle":"Finance","title":"Finance","menuTitle":null,"icon":"IconCoins","summary":"Úvěry, investice a účty srovnané napříč trhem.","cardPhoto":null,"heroTitle":null,"description":"Rodinné finance zahrnují veškeré finanční aspekty našeho života. Jejich správa není vždy jednoduchá, a proto máme tým zkušených specialistů, který je připravený vyhodnotit vaši situaci a navrhnout nejlepší kombinaci správy a investic vašich financí.","heroPhoto":152,"parent":null,"segments":["rodiny","podnikatele","mesta"],"slug":"finance","externalUrl":null,"updatedAt":"2026-11-25T11:52:49.583Z","createdAt":"2026-11-02T14:21:25.213Z","_status":"published"},"segments":["rodiny"],"slug":"uvery-na-bydleni","externalUrl":null,"updatedAt":"2026-11-25T15:07:40.958Z","createdAt":"2026-11-02T14:21:26.177Z","_status":"published"},{"id":6,"_order":"a5","adminTitle":"Pojištění majetku","title":"Pojištění majetku","menuTitle":"Majetek","icon":"IconHome","summary":"Nemovitost i domácnost","cardPhoto":null,"heroTitle":"Pojištění *majetku*","description":"„Můj dům, můj hrad“. Pojištění domácnosti je často klienty opomíjeno, jelikož se domnívají, že v pojištění nemovitosti již mají vše. Nicméně jsou to zcela rozdílné produkty.","heroPhoto":{"id":155,"filename":"pojisteni-nemovitosti-hero.jpg","alt":"Pojištění nemovitosti","visibility":"public","folder":1233,"updatedAt":"2026-11-02T14:21:15.121Z","createdAt":"2026-11-02T14:21:15.121Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/pojisteni-nemovitosti-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":923955,"width":1250,"height":833,"focalX":50,"focalY":50},"parent":{"id":1,"_order":"a0","adminTitle":"Pojištění","title":"Pojištění","menuTitle":null,"icon":"IconShield","summary":"Krytí rizik, která by vás jinak stála vlastní peníze.","cardPhoto":null,"heroTitle":null,"description":"Pojištění je důležitou součástí našich životů a chrání nás před dopady nečekaných událostí. Proto je zde náš komplexní servis v oblasti pojištěn