{"docs":[{"id":70,"_order":"b0x","adminTitle":"Allrisk nájem bez rizika","title":"Allrisk nájem bez rizika","menuTitle":"Nájem bez rizika","icon":"IconKey","summary":"Nájem na účtu každý měsíc","cardPhoto":null,"heroTitle":"Allrisk nájem *bez rizika*","description":"Není to jen služba o papírování a fakturách. Je to o důvěře, technické jistotě a rychlé reakci. A přesně to nabízíme. Přenechejte správu své nemovitosti profesionálům, kteří rozumí technickým detailům i lidskému přístupu. Jsme spolehlivý partner pro vlastníky bytů, SVJ, bytová družstva i investory.","heroPhoto":{"id":254,"filename":"risk-free-rental-hero.jpg","alt":"Allrisk nájem bez rizika","visibility":"public","folder":1426,"updatedAt":"2026-11-02T14:21:21.845Z","createdAt":"2026-11-02T14:21:21.845Z","url":"/allrisk-web-prototyp/api/allrisk-media/file/risk-free-rental-hero.jpg","thumbnailURL":null,"mimeType":"image/jpeg","filesize":398127,"width":1920,"height":1280,"focalX":50,"focalY":50},"heroVideo":null,"heroStills":[],"heroPoints":[{"id":"941afa68e6dddd9cb7b4e3a1","icon":"IconCalculator","text":"Zajišťujeme pravidelný příjem z pronájmu"},{"id":"3ba9fbadc8027afd905b7c05","icon":"IconGavel","text":"Jsme technickou a právní jistotou vaší nemovitosti"},{"id":"5d767bea582ff0f67590a44b","icon":"IconTool","text":"Řešíme za vás všechny revize, havárie i papírování"}],"heroButtons":[{"id":"1f4272cc4c2a847a187b010e","icon":null,"iconAfter":"IconArrowUpRight","variant":"primary","url":"#kontakt","newTab":null,"label":"Chci tento produkt"},{"id":"10bc1e783abadabbca8c7a7a","icon":null,"iconAfter":null,"variant":"outline","url":"/kontakty","newTab":null,"label":"Kontakty a pobočky"}],"similar":[{"id":67,"_order":"b0u","adminTitle":"Prodej a pronájem nemovitosti","title":"Prodej a pronájem nemovitosti","menuTitle":"Prodej nemovitostí","icon":"IconHomeDollar","summary":"Prodej i pronájem za nejlepší cenu","cardPhoto":null,"heroTitle":"*Prodej a pronájem* nemovitosti","description":"Nemovitosti nenabízíme, ale pro